---
import type { HTMLAttributes, SvgComponent } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Icon before the text. Takes the place of the marker. */
  icon?: SvgComponent;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  icon,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {icon ? (
        <Icon src={icon} class="eyebrow_icon" />
      ) : (
        variant === "default" && <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      /* A filled label, one step off the surface it sits on. A surface that
         already uses `--background-2`, like a card, sets `--_tag-background`. */
      &.tag {
        min-height: 1.75rem;
        padding: 0.25rem 0.625rem;
        border-radius: var(--radius-small);
        background-color: var(--_tag-background, var(--background-2));
        color: var(--text);
      }
      .eyebrow_marker {
        flex: none;
        width: 0.5rem;
        aspect-ratio: 1 / 1;
        border-radius: 0.125rem;
        background-color: var(--heading-accent);
      }
      .eyebrow_icon {
        --_size: 1.5rem;
        color: var(--heading-accent);
      }
      &.tag .eyebrow_icon {
        --_size: 1rem;
      }
      .eyebrow_text {
        color: var(--text-2);
        font-weight: var(--primary-medium);
      }
      &.tag .eyebrow_text {
        color: inherit;
        font-size: 0.875rem;
        letter-spacing: 0.01em;
        line-height: var(--line-height-large);
      }
    }
  }
</style>
