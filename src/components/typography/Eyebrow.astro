---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class="eyebrow_text text-style-label">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    /* A flex box, not inline: an inline box would sit on a text line and pick up its height */
    .eyebrow_wrap {
      display: flex;
      width: fit-content;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);

      &.tag {
        background-color: var(--background-2);
        color: var(--text);
        padding: 0.25rem 0.625rem;
        border-radius: var(--radius-small);
      }
      .eyebrow_marker {
        flex: none;
        width: 0.5rem;
        aspect-ratio: 1 / 1;
        border-radius: 0.125rem;
        background-color: var(--accent);
      }
      .eyebrow_text {
        color: var(--text-2);
        margin: 0;
      }
      &.tag .eyebrow_text {
        color: inherit;
      }
    }
  }
</style>
