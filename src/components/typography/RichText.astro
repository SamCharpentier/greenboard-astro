---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type RichTextStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Type style. */
  variant?: RichTextStyle;
  /** Size headings for a reading column: `h2` reads as `h4`, `h3` as `h5`, `h4` as `h6`. */
  article?: boolean;
  /**
   * Maximum line length in characters.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const {
  render = true,
  variant = "inherit",
  article = false,
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={[
        "text",
        "rich-text",
        variant !== "inherit" && `text-style-${variant}`,
        article && "article",
        className,
      ]}
      style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
      {...rest}
    >
      <Fragment set:html={content} />
    </div>
  )
}

<style is:global>
  @layer components {
    .rich-text {
      /* Fills its column, so a wide table or embed scrolls inside it */
      width: 100%;

      & :is(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote, figure, pre, table) {
        margin-top: var(--_margin-top);
        margin-bottom: var(--_margin-bottom);
      }

      & > :first-child,
      & :is(blockquote, li) > :first-child:not(:is(ul, ol)) {
        margin-top: 0;
      }
      & > :last-child,
      & :is(blockquote, li) > :last-child {
        margin-bottom: 0;
      }

      & :is(ul, ol) {
        padding-left: 1.5em;
      }
      & ul {
        list-style-type: disc;
      }
      & ul ul {
        list-style-type: circle;
      }
      & ul ul ul {
        list-style-type: square;
      }
      & ol {
        list-style-type: decimal;
      }
      & li::marker {
        color: color-mix(in lab, currentcolor 60%, transparent);
      }
      & li + li {
        margin-top: var(--space-2);
      }

      & li > :is(ul, ol) {
        margin-block: var(--space-2);
      }

      & blockquote {
        padding-left: var(--space-4);
        border-left: var(--border-width) solid var(--border);
      }

      /* Long form: pull quotes, media, tables */
      & blockquote:has(cite) {
        margin-block: var(--space-7);
        padding-left: var(--space-5);
        border-left: calc(var(--border-width) * 2) solid var(--heading-accent);
        color: var(--text);
        font-size: var(--text-large);
        line-height: var(--text-large-line-height);
        & > * {
          --_margin-top: var(--space-4);
          --_margin-bottom: var(--space-4);
        }
      }
      & cite {
        display: block;
        color: var(--text-2);
        font-size: var(--text-small);
        font-style: normal;
        line-height: var(--text-small-line-height);
      }

      & :is(img, video, iframe) {
        display: block;
        width: 100%;
        height: auto;
        border-radius: var(--radius-small);
      }
      & iframe {
        aspect-ratio: 16 / 9;
        border: 0;
        background-color: var(--background-skeleton);
      }

      /* A table sits on the surface color and scrolls inside it on a phone */
      & table {
        display: block;
        overflow-x: auto;
        padding: var(--space-2) var(--space-4);
        border-collapse: separate;
        border-spacing: 0;
        border-radius: var(--radius-main);
        background-color: var(--background-2);
        font-size: var(--text-small);
        line-height: var(--text-small-line-height);
      }
      & :is(th, td) {
        min-width: 8rem;
        padding: var(--space-3) var(--space-4);
        border-bottom: var(--border-width) solid var(--border);
        text-align: left;
        vertical-align: top;
      }
      & tbody tr:last-child > * {
        border-bottom: 0;
      }
      & thead th {
        color: var(--text);
        font-weight: var(--primary-medium);
      }
      & tbody > tr > :first-child {
        color: var(--text);
      }
      /* The Greenboard column, marked when the page is built */
      & .is-ours {
        background-color: color-mix(in srgb, var(--heading-accent) 10%, transparent);
        color: var(--text);
      }
      & thead .is-ours {
        border-top-left-radius: var(--radius-small);
        border-top-right-radius: var(--radius-small);
      }
      & tbody tr:last-child .is-ours {
        border-bottom-left-radius: var(--radius-small);
        border-bottom-right-radius: var(--radius-small);
      }

      /* Headings one step closer to the text, for a reading column */
      &.article {
        & h2 {
          font-size: var(--h4);
          font-weight: var(--h4-font-weight);
          line-height: var(--h4-line-height);
          letter-spacing: var(--h4-letter-spacing);
          --_margin-top: var(--space-8);
          --_margin-bottom: var(--h4-margin-bottom);
        }
        & h3 {
          font-size: var(--h5);
          font-weight: var(--h5-font-weight);
          line-height: var(--h5-line-height);
          letter-spacing: var(--h5-letter-spacing);
          --_margin-top: var(--space-7);
          --_margin-bottom: var(--h5-margin-bottom);
        }
        & h4 {
          font-size: var(--h6);
          font-weight: var(--h6-font-weight);
          line-height: var(--h6-line-height);
          letter-spacing: var(--h6-letter-spacing);
          --_margin-top: var(--h6-margin-top);
          --_margin-bottom: var(--h6-margin-bottom);
        }
        & :is(p, ul, ol) + :is(img, iframe, table),
        & p:has(> :is(img, iframe):only-child) {
          margin-block: var(--space-7);
        }
      }
    }
  }
</style>
