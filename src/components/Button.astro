---
import type { HTMLAttributes } from "astro/types";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";
import diagonal from "@/assets/icons/arrow-up-right.svg";
import back from "@/assets/icons/arrow-left.svg";
import close from "@/assets/icons/close.svg";
import play from "@/assets/icons/play.svg";
import pause from "@/assets/icons/pause.svg";
import { slotContent } from "@/utils/slots.ts";

type Emphasis = "primary" | "secondary";

type Size = "small" | "medium" | "large";

type Tag =
  | (HTMLAttributes<"button"> & {
      /** Rendered element. */
      element?: "button";
      /** Native button type. */
      type?: "button" | "submit" | "reset";
      /** Disable the button. */
      disabled?: boolean;
      href?: never;
    })
  | (Omit<HTMLAttributes<"a">, "type"> & {
      element: "link";
      /** Link destination. */
      href?: string;
      type?: never;
      disabled?: never;
    })
  | (HTMLAttributes<"span"> & {
      /** `span` draws the button without an action, for a card that is itself the link. */
      element: "span";
      href?: never;
      type?: never;
      disabled?: never;
    });

type Kind =
  | {
      /** Button type. */
      variant?: "main";
      /** Visual emphasis. */
      emphasis?: Emphasis;
      /** Button size. */
      size?: Size;
      /** Trailing icon. */
      icon?: "arrow" | "none";
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "link";
      /** A link carries no weight of its own: it is already the quietest. */
      emphasis?: never;
      /** Text size. */
      size?: "small" | "medium";
      /** Trailing icon. `diagonal` marks an external or index link. */
      icon?: "arrow" | "diagonal" | "none";
      label?: never;
      pressed?: never;
      direction?: never;
    }
  | {
      variant: "play";
      emphasis?: Emphasis;
      size?: Size;
      /** Accessible label. Defaults to `Play` or `Pause`. */
      label?: string;
      /** Show the pause icon and pressed state. */
      pressed?: boolean;
      icon?: never;
      direction?: never;
    }
  | {
      variant: "close";
      emphasis?: Emphasis;
      size?: Size;
      /** Accessible label. Defaults to `Close`. */
      label?: string;
      pressed?: never;
      icon?: never;
      direction?: never;
    }
  | {
      variant: "arrow";
      emphasis?: Emphasis;
      size?: Size;
      /** Accessible label. Defaults to `Next` or `Previous`. */
      label?: string;
      pressed?: never;
      icon?: never;
      /** Arrow direction. */
      direction?: "forward" | "back";
    };

type Props = {
  /** Set to `false` to omit the component. */
  render?: boolean;
} & Tag &
  Kind;

type AllProps = HTMLAttributes<"button"> &
  Omit<HTMLAttributes<"a">, "type"> & {
    render?: boolean;
    variant?: "main" | "link" | "play" | "close" | "arrow";
    emphasis?: Emphasis;
    size?: Size;
    icon?: "arrow" | "diagonal" | "none";
    label?: string;
    pressed?: boolean;
    direction?: "forward" | "back";
    element?: "button" | "link" | "span";
    href?: string;
    type?: "button" | "submit" | "reset";
  };

const {
  render = true,
  variant = "main",
  emphasis = "primary",
  size = "medium",
  icon = "arrow",
  label,
  pressed = false,
  direction = "forward",
  element = "button",
  href,
  type = "button",
  class: className,
  ...rest
} = Astro.props as AllProps;

/* `span` renders like the other two; typed as one of them so the shared attributes check */
const Tag = (element === "link" ? "a" : element === "span" ? "span" : "button") as "a" | "button";
const tagAttrs: Record<string, string> =
  element === "link" ? { href: href || "#" } : element === "span" ? {} : { type };

/* main and link are written, the rest are marks with a label. */
const isWritten = variant === "main" || variant === "link";
const content = isWritten ? await slotContent(Astro.slots) : "";

const named = {
  play: pressed ? "Pause" : "Play",
  close: "Close",
  arrow: direction === "back" ? "Previous" : "Next",
};

const trailing = isWritten && icon !== "none" ? (icon === "diagonal" ? diagonal : arrow) : undefined;
---

{
  render && (isWritten ? content : true) && (
    <Tag
      class:list={[
        "button_wrap",
        emphasis !== "primary" && variant !== "link" && emphasis,
        variant !== "main" && variant,
        size !== "medium" && size,
        icon === "diagonal" && "diagonal",
        className,
      ]}
      aria-label={isWritten ? undefined : (label ?? named[variant])}
      aria-pressed={variant === "play" ? pressed : undefined}
      {...tagAttrs}
      {...rest}
    >
      {isWritten && (
        <span
          class:list={[
            "button_text",
            variant === "link" && size === "small" ? "text-style-small" : "text-style-main",
          ]}
        >
          <Fragment set:html={content} />
        </span>
      )}
      {trailing && <Icon class="button_icon" src={trailing} variant="small" />}
      {variant === "play" && (
        <Fragment>
          <Icon class="button_mark button_play" src={play} variant="small" />
          <Icon class="button_mark button_pause" src={pause} variant="small" />
        </Fragment>
      )}
      {variant === "close" && (
        <Icon class="button_mark" src={close} variant="small" />
      )}
      {variant === "arrow" && (
        <Icon
          class="button_mark"
          src={direction === "back" ? back : arrow}
          variant="small"
        />
      )}
    </Tag>
  )
}

<style is:global>
  @layer components {
    .button_wrap {
      --_height: var(--button-size-medium);
      --_pad-block: var(--space-2);
      --_pad-inline: var(--space-5);
      --_shift: 0;
      position: relative;
      display: inline-flex;
      flex-shrink: 0;
      justify-content: center;
      align-items: center;
      gap: var(--space-2);
      min-height: var(--_height);
      padding: var(--_pad-block) var(--_pad-inline);
      background-color: var(--button-background);
      color: var(--button-text);
      border: var(--border-width) solid var(--button-border);
      border-radius: var(--radius-round);
      text-decoration: none;
      text-align: center;
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover:not(:disabled) {
          --_shift: 1;
          background-color: var(--button-background-hover);
          color: var(--button-text-hover);
          border-color: var(--button-border-hover);
        }
      }
      &:focus-visible {
        --_shift: 1;
        background-color: var(--button-background-hover);
        color: var(--button-text-hover);
        border-color: var(--button-border-hover);
      }
      &.small {
        --_height: var(--button-size-small);
        --_pad-block: var(--space-1);
        --_pad-inline: var(--space-4);
      }
      &.large {
        --_height: var(--button-size-large);
        --_pad-inline: var(--space-6);
      }
      &.secondary {
        --button-background: var(--button-2-background);
        --button-text: var(--button-2-text);
        --button-border: var(--button-2-border);
        --button-background-hover: var(--button-2-background-hover);
        --button-text-hover: var(--button-2-text-hover);
        --button-border-hover: var(--button-2-border-hover);
      }
      .button_text {
        font-weight: var(--primary-medium);
        line-height: 1;
        white-space: nowrap;
      }
      .button_icon {
        margin-right: calc(var(--space-1) * -1);
        translate: calc(0.1875rem * var(--_shift)) 0;
        transition: translate var(--hover-duration) var(--hover-ease);
      }

      /* Text link: inline action with an arrow */
      &.link {
        --button-background: transparent;
        --button-border: transparent;
        --button-background-hover: transparent;
        --button-border-hover: transparent;
        --button-text: var(--link-text);
        --button-text-hover: var(--link-text-hover);
        min-height: 0;
        gap: var(--space-1);
        padding: 0;
        border: 0;
        border-radius: 0;
        /* Untrimmed, so the underline keeps its distance below the descenders */
        .button_text {
          padding-bottom: 0.125em;
          border-bottom: var(--border-width) solid var(--link-border);
          line-height: var(--line-height-huge);
          white-space: normal;
          transition: border-color var(--hover-duration) var(--hover-ease);
          &::before,
          &::after {
            content: none;
          }
        }
        .button_icon {
          --_size: 1em;
          margin-right: 0;
        }
        &.diagonal .button_icon {
          translate: calc(0.125em * var(--_shift)) calc(-0.125em * var(--_shift));
        }
        @media (hover: hover) {
          &:hover .button_text {
            border-bottom-color: var(--link-border-hover);
          }
        }
        &:focus-visible .button_text {
          border-bottom-color: var(--link-border-hover);
        }
      }

      /* Marks: round buttons with one icon */
      &:is(.play, .close, .arrow) {
        width: var(--_height);
        aspect-ratio: 1 / 1;
        gap: 0;
        padding: 0;
        .button_mark {
          --_size: 1.125rem;
        }
      }
      &.play .button_pause {
        display: none;
      }
      &.play[aria-pressed="true"] {
        & .button_play {
          display: none;
        }
        & .button_pause {
          display: block;
        }
      }
      &:disabled {
        cursor: not-allowed;
        opacity: 0.5;
      }
    }
  }
</style>
