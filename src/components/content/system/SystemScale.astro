---
import type { HTMLAttributes } from "astro/types";
import { range } from "@/utils/tokens.ts";

type Props = HTMLAttributes<"ul"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fluid tokens to draw, each with what it is for. */
  rows?: { token: string; note: string }[];
};

const { render = true, rows = [], class: className, ...rest } = Astro.props;
---

{
  render && rows.length > 0 && (
    <ul class:list={["system-scale_wrap", className]} role="list" {...rest}>
      {rows.map(({ token, note }) => (
        <li class="system-scale_item text-style-small">
          <code class="system-scale_token">--{token}</code>
          <span class="system-scale_bar" style={`--_size: var(--${token})`} />
          <span class="system-scale_range">{range(token)}</span>
          <span class="system-scale_note color-faded">{note}</span>
        </li>
      ))}
    </ul>
  )
}

<style is:global>
  @layer components {
    .system-scale_wrap {
      width: 100%;
      margin: 0;
      padding: 0;
      list-style: none;
      @media (width >= 48rem) {
        .system-scale_item {
          grid-template-columns: 14rem minmax(0, 1fr) 7rem 16rem;
        }
        :is(.system-scale_bar, .system-scale_range, .system-scale_note) {
          grid-row: auto;
          grid-column: auto;
        }
      }
    }

    .system-scale_item {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      padding-block: var(--space-3);
      border-top: var(--border-width) solid var(--border);
      &::before,
      &::after {
        content: none;
      }
    }

    .system-scale_token {
      justify-self: start;
    }

    .system-scale_bar {
      grid-column: 1 / -1;
      width: var(--_size);
      height: 0.75rem;
      border-radius: 0.125rem;
      background-color: var(--heading-accent);
    }

    .system-scale_range {
      grid-row: 1;
      grid-column: 2;
    }

    .system-scale_note {
      grid-column: 1 / -1;
    }
  }
</style>
