---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"dl"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

const facts = await slotContent(Astro.slots);
---

{
  render && facts && (
    <dl class:list={["facts_wrap", className]} {...rest}>
      <Fragment set:html={facts} />
    </dl>
  )
}

<style is:global>
  @layer components {
    /* Each fact is a `div` holding a `dt` label and a `dd` value */
    .facts_wrap {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      width: 100%;
      border-top: var(--border-width) solid var(--border);
      & > div {
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
        padding-block: var(--space-6);
      }
      & > div + div {
        border-top: var(--border-width) solid var(--border);
      }
      & dt {
        color: var(--text-2);
      }
      & dd {
        font-size: var(--text-large);
        line-height: var(--text-large-line-height);
      }
      @media (width >= 48rem) {
        grid-auto-columns: minmax(0, 1fr);
        grid-auto-flow: column;
        & > div {
          padding-right: var(--space-5);
        }
        & > div + div {
          padding-left: var(--space-5);
          border-top: 0;
          border-left: var(--border-width) solid var(--border);
        }
      }
    }
  }
</style>
