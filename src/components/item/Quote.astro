---
import type { HTMLAttributes } from "astro/types";
import Byline from "@/components/item/Byline.astro";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"figure"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Who said it. */
  name?: string;
  /** Their role and company. */
  position?: string;
  /** Portrait. Takes the place of `initials`. */
  image?: ImageMetadata;
  /** Letters shown in place of a portrait. */
  initials?: string;
  /** Quote size. `card` sets it on a surface, as the lead quote of a story. */
  variant?: "default" | "large" | "card";
};

const {
  render = true,
  name,
  position,
  image,
  initials,
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const text = await slotContent(Astro.slots);
---

{
  render && text && (
    <figure
      class:list={["quote_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      <blockquote
        class:list={[
          "quote_text",
          ({ large: "text-style-h2", card: "text-style-h5", default: "text-style-h3" } as const)[variant],
        ]}
      >
        <p>
          “<Fragment set:html={text} />”
        </p>
      </blockquote>
      {name && (
        <figcaption class="quote_author">
          <Byline
            name={name}
            position={position}
            image={image}
            initials={initials}
          />
        </figcaption>
      )}
    </figure>
  )
}

<style is:global>
  @layer components {
    .quote_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
      width: 100%;
      &.card {
        padding: var(--space-6);
        border-radius: var(--radius-main);
        background-color: var(--background-2);
      }
    }

    .quote_text {
      max-width: 34ch;
      & p {
        text-wrap: inherit;
      }
      .card > & {
        max-width: none;
      }
    }
  }
</style>
