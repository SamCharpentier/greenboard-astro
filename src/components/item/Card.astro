---
import type { HTMLAttributes, SvgComponent } from "astro/types";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Img from "@/components/media/Img.astro";
import Byline from "@/components/item/Byline.astro";
import Overlay from "@/components/media/Overlay.astro";
import Icon from "@/components/media/Icon.astro";
import diagonal from "@/assets/icons/arrow-up-right.svg";
import { slotContent } from "@/utils/slots.ts";
import { logoHeight } from "@/utils/logo.ts";

type ImageSource = ImageMetadata | string;

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Icon before the eyebrow, in place of its marker. */
  icon?: SvgComponent;
  /** Eyebrow text. Supports inline markup. */
  eyebrow?: string;
  /** Short note beside the eyebrow. */
  meta?: string;
  /** Card title. Supports inline markup. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Line under the heading, in the accent color. */
  lead?: string;
  /** Body text. Supports inline markup. */
  text?: string;
  /** Button label. Omit for an arrow alone when `buttonHref` is set. */
  buttonLabel?: string;
  /** Button destination. Omit for a `<button>`. */
  buttonHref?: string;
  /** Card layout. */
  variant?: "default" | "cover" | "stacked" | "feature" | "split" | "person" | "row" | "quote";
  /** Color theme of element and its children. */
  theme?: "inherit" | "light" | "soft" | "dark" | "deep" | "brand" | "invert";
};

type Unquoted = {
  quote?: never;
  name?: never;
  position?: never;
  portrait?: never;
};

type Props = Base &
  (
    | (Unquoted & {
        variant?: "default";
        image?: never;
        imageAlt?: never;
      })
    | (Unquoted & {
        variant: "cover";
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      })
    | (Unquoted & {
        variant: "stacked";
        /** Color theme of element and its children. */
        theme?: never;
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
        /** How the image fills its frame. `contain` sets a logo on the surface color, uncropped. */
        imageFit?: "cover" | "contain";
      })
    | (Unquoted & {
        variant: "feature";
        /** Color theme of element and its children. */
        theme?: never;
        image?: never;
        imageAlt?: never;
      })
    | (Unquoted & {
        variant: "split";
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
        /** How the image fills its frame. `contain` sets a logo on the surface color, uncropped. */
        imageFit?: "cover" | "contain";
      })
    | (Unquoted & {
        variant: "person";
        /** Color theme of element and its children. */
        theme?: never;
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      })
    | (Unquoted & {
        variant: "row";
        image?: never;
        imageAlt?: never;
      })
    | {
        variant: "quote";
        /** Company logo, set above the quote. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
        /** What they said. */
        quote?: string;
        /** Who said it. */
        name?: string;
        /** Their role and company. */
        position?: string;
        /** Portrait of who said it. */
        portrait?: ImageMetadata;
        /** Names the arrow in the corner for screen readers. The whole card links to `buttonHref`. */
        buttonLabel?: string;
      }
  );

type AllProps = Base & {
  image?: ImageSource;
  imageAlt?: string;
  imageFit?: "cover" | "contain";
  quote?: string;
  name?: string;
  position?: string;
  portrait?: ImageMetadata;
};

const {
  render = true,
  icon,
  eyebrow,
  meta,
  heading,
  headingTag = "h3",
  lead,
  text,
  buttonLabel,
  buttonHref,
  variant = "default",
  theme = "inherit",
  image,
  imageAlt,
  imageFit = "cover",
  quote,
  name,
  position,
  portrait,
  class: className,
  ...rest
} = Astro.props as AllProps;

const details = await slotContent(Astro.slots);

const surfaced = ["default", "cover", "split", "row", "quote"].includes(variant);
const pictured = ["cover", "stacked", "split", "person", "quote"].includes(variant);
const hasImage = pictured && !!image;

/* Titles and text sized to the card, so a set of cards reads as one system */
const headingVariant = ({ split: "h3", row: "h5", person: "h6" } as const)[
  variant as "split" | "row" | "person"
] ?? "h4";
const textVariant = variant === "split" ? "main" : "small";
const quoted = variant === "quote";
const arrowOnly = (quoted || !buttonLabel) && !!buttonHref;
const hasContent = !!(
  eyebrow || heading || text || quote || details || buttonLabel || arrowOnly
);
const hasTheme = surfaced && theme !== "inherit";

/* The button each variant closes with, so a set of cards reads as one system.
   A link carries no emphasis of its own, so the two are picked together. */
const buttonKind =
  variant === "cover"
    ? ({ emphasis: "primary" } as const)
    : ({ variant: "link", icon: "diagonal" } as const);

/* The arrow alone still needs a name: the heading, without its markup */
const arrowLabel = quoted ? buttonLabel : heading?.replace(/<[^>]*>/g, "").trim();

/* A logo covers the same area whatever its shape, so a set of them reads level */
const LOGO_AREA = 5600;
const logo =
  quoted && image && typeof image !== "string"
    ? logoHeight(image, LOGO_AREA)
    : undefined;

if (import.meta.env.DEV && render) {
  if (!surfaced && theme !== "inherit") {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no surface to color, so \`theme\` was dropped. It keeps the theme around it.`,
    );
  }
  if (!pictured && image) {
    console.warn(
      `[lumos] <Card variant="${variant}"> holds no image, so \`image\` was dropped. Use the cover, stacked, split, person or quote variant to show it.`,
    );
  }
  if (pictured && !quoted && !image) {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no \`image\`, so it renders as a plain card.`,
    );
  }
}
---

{
  render && (hasContent || hasImage) && (
    <div
      class:list={[
        "card_wrap",
        variant !== "default" && variant,
        hasTheme && `theme-${theme}`,
        className,
      ]}
      {...rest}
    >
      {hasImage && (
        <div
          class:list={[
            "card_visual",
            quoted ? "logo" : imageFit === "contain" && "contain",
          ]}
          style={logo ? `--_logo-height: ${logo / 16}rem` : undefined}
        >
          {quoted ? (
            <Img
              src={image!}
              alt={imageAlt}
              variant="densities"
              height={logo}
              transparent
            />
          ) : (
            <Img src={image!} alt={imageAlt} transparent={imageFit === "contain"} />
          )}
          {variant === "cover" && <Overlay variant="gradient" />}
        </div>
      )}
      {hasContent && (
        <div class="card_content margin-trim">
          {(eyebrow || meta) && (
            <div class="card_header">
              <Eyebrow variant={surfaced ? "tag" : "default"} icon={icon}>
                <Fragment set:html={eyebrow} />
              </Eyebrow>
              {meta && <p class="card_meta text-style-small">{meta}</p>}
            </div>
          )}
          <Heading tag={headingTag} variant={headingVariant}>
            <Fragment set:html={heading} />
          </Heading>
          {lead && <p class="card_lead text-style-small">{lead}</p>}
          {quoted && quote && (
            <figure class="card_quote">
              <blockquote class="text-style-h5">
                <p>
                  “<Fragment set:html={quote} />”
                </p>
              </blockquote>
              {name && (
                <figcaption>
                  <Byline
                    name={name}
                    position={position}
                    image={portrait}
                    size="large"
                  />
                </figcaption>
              )}
            </figure>
          )}
          <Paragraph variant={textVariant} class="color-faded">
            <Fragment set:html={text} />
          </Paragraph>
          {details && (
            <div class="card_details margin-trim">
              <Fragment set:html={details} />
            </div>
          )}
          {arrowOnly ? (
            <a class="card_arrow" href={buttonHref} aria-label={arrowLabel}>
              <Icon src={diagonal} variant="small" />
            </a>
          ) : (
            <ButtonWrapper>
              {buttonHref ? (
                <Button element="link" href={buttonHref} {...buttonKind}>
                  {buttonLabel}
                </Button>
              ) : (
                <Button {...buttonKind}>{buttonLabel}</Button>
              )}
            </ButtonWrapper>
          )}
        </div>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .card_wrap {
      --_padding: var(--space-6);
      --_min-height: 20rem;
      --_visual-ratio: 3 / 2;
      --_tag-background: var(--background);
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--_padding);
      position: relative;
      background-color: var(--background-2);
      border-radius: var(--radius-main);
      overflow: clip;

      /* In a ruled grid the card sits flush on the section color, so a linked
         card lifts to the surface color while it is hovered or focused */
      .ruled > & {
        --_tag-background: var(--background-2);
      }
      .ruled > &:has(:is(.button_wrap, .card_arrow)) {
        transition: background-color var(--hover-duration) var(--hover-ease);
        &:has(:focus-visible) {
          background-color: var(--background-2);
        }
        @media (hover: hover) {
          &:hover {
            background-color: var(--background-2);
          }
        }
      }

      &.cover {
        min-height: var(--_min-height);
      }
      &:is(.stacked, .feature) {
        background-color: transparent;
        overflow: visible;
      }
      /* Wide enough for a cover designed at 1.9:1 to keep its edges */
      &.stacked {
        --_visual-ratio: 16 / 9;
      }
      &.feature {
        border-top: var(--border-width) solid var(--border);
        border-radius: 0;
      }
      &:is(.split, .row) {
        border: var(--border-width) solid var(--border);
        transition: border-color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:has(:is(.button_wrap, .card_arrow)):hover {
            border-color: var(--background-2);
          }
        }
      }
      &.split {
        gap: 0;
        @media (width >= 48rem) {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          & > .card_visual {
            grid-column: 2;
            grid-row: 1;
            min-height: 100%;
          }
        }
      }
      &.person {
        --_padding: var(--space-4);
        --_visual-ratio: 4 / 5;
        background-color: transparent;
        overflow: visible;
      }
      /* The logo and the arrow share the top row, the quote the next, and the
         result closes the card across its full width. In a grid the rows are
         shared, so every card in a row draws its rule at the same height. */
      &.quote {
        display: grid;
        grid-row: span 3;
        grid-template-columns: minmax(0, 1fr) auto;
        grid-template-rows: subgrid;
        gap: var(--space-6) var(--space-4);
        padding: var(--_padding);
        & > .card_content {
          display: contents;
        }
        & > .card_content > :not(.card_arrow) {
          grid-column: 1 / -1;
        }
        &:has(.card_arrow) {
          transition: background-color var(--hover-duration) var(--hover-ease);
          &:has(:focus-visible) {
            background-color: var(--background-3);
          }
          @media (hover: hover) {
            &:hover {
              background-color: var(--background-3);
            }
          }
        }
      }
    }

    .card_visual {
      position: relative;
      width: 100%;
      min-height: 0;
      flex: none;
      border-radius: inherit;
      overflow: clip;

      :is(.stacked, .split, .person) > & {
        aspect-ratio: var(--_visual-ratio);
      }

      .person > & {
        border-radius: var(--radius-main);
        background-color: var(--background-2);
      }

      /* A logo on a quote card sits in a band of fixed height, so the quotes
         beside it start level */
      &.logo {
        display: flex;
        align-items: center;
        width: auto;
        height: 4rem;
        border-radius: 0;
        overflow: visible;
        & > .image {
          width: auto;
          height: var(--_logo-height, 2.5rem);
          max-height: 100%;
        }
      }

      /* A logo sits small and centred on the surface, whatever its shape */
      &.contain {
        padding: 18% 28%;
        border-radius: var(--radius-main);
        background-color: var(--background-2);
      }

      .cover > & {
        position: absolute;
        inset: 0;
        height: 100%;
        pointer-events: none;
      }

      > :is(.image, .video) {
        width: 100%;
        height: 100%;
      }
    }

    /* Media fills its box, be that the whole card or the band across its top.
       The component layer puts this above the `height: auto` every image and
       video starts from. */
    .card_visual > :is(.image, .video) {
      width: 100%;
      height: 100%;
    }

    /* Buttons closing a card sit on its floor, however tall the row around it
       grows. This outranks the margin `.button-wrapper` sets for itself. */
    .card_content > :is(.button-wrapper, .card_arrow):last-child {
      margin-top: auto;
      padding-top: var(--space-6);
    }

    :is(.row, .quote) > .card_content > :is(.button-wrapper, .card_arrow):last-child {
      margin-top: 0;
      padding-top: 0;
    }

    .quote > .card_content > .card_arrow {
      grid-area: 1 / 2;
      align-self: center;
    }

    .card_content {
      display: flex;
      flex-direction: column;
      align-items: var(--_alignment, start);
      text-align: var(--_alignment, start);
      flex-grow: 1;
      width: 100%;
      max-width: 100%;
      padding: var(--_padding);

      .cover > & {
        z-index: 1;
      }

      :is(.stacked, .feature, .person) > & {
        padding-inline: 0;
        padding-top: 0;
      }

      .person > & {
        padding-bottom: 0;
      }

      .split > & {
        justify-content: space-between;
        padding: var(--space-7) var(--space-6);
      }

      /* Text on the left, the link on the right. On a phone the link drops
         under the text. */
      .row > & {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        align-items: center;
        gap: 0 var(--space-5);
        padding: var(--space-5) var(--space-6);
        & > :is(.button-wrapper, .card_arrow):last-child {
          padding-top: var(--space-5);
        }
        @media (width >= 48rem) {
          grid-template-columns: minmax(0, 1fr) auto;
          & > * {
            grid-column: 1;
          }
          & > :is(.button-wrapper, .card_arrow):last-child {
            grid-column: 2;
            grid-row: 1 / span 4;
            padding-top: 0;
          }
        }
      }

      .feature > & {
        padding-top: var(--space-5);
        padding-bottom: 0;
      }
    }

    .card_header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      width: 100%;
      margin-bottom: var(--space-6);
      :is(.stacked, .row) > .card_content > & {
        margin-bottom: var(--space-4);
        & + .heading {
          margin-top: 0;
        }
      }
    }

    .card_meta {
      color: var(--text-2);
    }

    .card_lead {
      margin-top: var(--space-2);
      color: var(--heading-accent);
      font-weight: var(--primary-medium);
    }

    .card_lead + .text {
      margin-top: var(--space-2);
    }

    /* A card that also carries a details list has a lot to hold, so its parts
       sit closer and the card keeps to the height of its content */
    .card_wrap:not(.quote):has(> .card_content > .card_details) {
      --_padding: var(--space-5);
      & > .card_content {
        & > .card_header {
          margin-bottom: var(--space-4);
        }
        & > .card_header + .heading {
          margin-top: 0;
        }
        & > :is(.button-wrapper, .card_arrow):last-child {
          padding-top: var(--space-5);
        }
      }
    }

    .card_details {
      width: 100%;
      margin-top: var(--space-5);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);

      /* The rule and its padding already hold the space above, so what comes
         first adds none of its own. margin-trim can't do this: it sits in a
         lower layer than the margin a list sets for itself. */
      & > :first-child {
        margin-top: 0;
      }

      /* The rule runs edge to edge under a quote */
      .quote > .card_content > & {
        width: auto;
        margin: 0 calc(var(--_padding) * -1);
        padding-inline: var(--_padding);
      }
    }

    .card_quote {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    /* The icon moves, not the link: a moved link would hold the overlay that
       makes the whole card clickable to its own small box */
    .card_arrow {
      display: flex;
      color: var(--text);
      transition: color var(--hover-duration) var(--hover-ease);
      & > .icon {
        transition: translate var(--hover-duration) var(--hover-ease);
      }
    }

    .card_wrap:has(:is(.button_wrap, .card_arrow)) {
      :is(.button_wrap, .card_arrow)::after {
        content: "";
        position: absolute;
        inset: 0;
      }

      .card_content a:not(.button_wrap, .card_arrow) {
        position: relative;
        z-index: 1;
      }

      .image {
        transition: scale calc(var(--hover-duration) * 2) var(--hover-ease);
      }

      @media (hover: hover) {
        &:hover .card_visual:not(.logo) > .image {
          scale: 1.04;
        }
        &:hover .card_arrow {
          color: var(--link-text-hover);
        }
        &:hover .card_arrow > .icon {
          translate: 0.125em -0.125em;
        }
      }
    }
  }
</style>
