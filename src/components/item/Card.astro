---
import type { HTMLAttributes } from "astro/types";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Img from "@/components/media/Img.astro";
import Overlay from "@/components/media/Overlay.astro";
import Icon from "@/components/media/Icon.astro";
import diagonal from "@/assets/icons/arrow-up-right.svg";
import { slotContent } from "@/utils/slots.ts";

type ImageSource = ImageMetadata | string;

type Base = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Eyebrow text. Supports inline markup. */
  eyebrow?: string;
  /** Short note beside the eyebrow. */
  meta?: string;
  /** Card title. Supports inline markup. */
  heading?: string;
  /** Heading level. */
  headingTag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Line under the heading, in the accent color. */
  lead?: string;
  /** Body text. Supports inline markup. */
  text?: string;
  /** Button label. Omit for an arrow alone when `buttonHref` is set. */
  buttonLabel?: string;
  /** Button destination. Omit for a `<button>`. */
  buttonHref?: string;
  /** Card layout. */
  variant?: "default" | "cover" | "stacked" | "feature" | "split" | "person" | "row";
  /** Color theme of element and its children. */
  theme?: "inherit" | "light" | "soft" | "dark" | "deep" | "brand" | "invert";
};

type Props = Base &
  (
    | {
        variant?: "default";
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "cover";
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      }
    | {
        variant: "stacked";
        /** Color theme of element and its children. */
        theme?: never;
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      }
    | {
        variant: "feature";
        /** Color theme of element and its children. */
        theme?: never;
        image?: never;
        imageAlt?: never;
      }
    | {
        variant: "split";
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      }
    | {
        variant: "person";
        /** Color theme of element and its children. */
        theme?: never;
        /** Image source. */
        image?: ImageSource;
        /** Image alt text. Omit for decorative images. */
        imageAlt?: string;
      }
    | {
        variant: "row";
        image?: never;
        imageAlt?: never;
      }
  );

type AllProps = Base & {
  image?: ImageSource;
  imageAlt?: string;
};

const {
  render = true,
  eyebrow,
  meta,
  heading,
  headingTag = "h3",
  lead,
  text,
  buttonLabel,
  buttonHref,
  variant = "default",
  theme = "inherit",
  image,
  imageAlt,
  class: className,
  ...rest
} = Astro.props as AllProps;

const details = await slotContent(Astro.slots);

const surfaced = ["default", "cover", "split", "row"].includes(variant);
const pictured = ["cover", "stacked", "split", "person"].includes(variant);
const hasImage = pictured && !!image;

/* Titles and text sized to the card, so a set of cards reads as one system */
const headingVariant = ({ split: "h3", row: "h5", person: "h6" } as const)[
  variant as "split" | "row" | "person"
] ?? "h4";
const textVariant = variant === "split" ? "main" : "small";
const arrowOnly = !buttonLabel && !!buttonHref;
const hasContent = !!(eyebrow || heading || text || details || buttonLabel || arrowOnly);
const hasTheme = surfaced && theme !== "inherit";

/* The button each variant closes with, so a set of cards reads as one system.
   A link carries no emphasis of its own, so the two are picked together. */
const buttonKind =
  variant === "cover"
    ? ({ emphasis: "primary" } as const)
    : ({ variant: "link", icon: "diagonal" } as const);

/* The arrow alone still needs a name: the heading, without its markup */
const arrowLabel = heading?.replace(/<[^>]*>/g, "").trim();

if (import.meta.env.DEV && render) {
  if (!surfaced && theme !== "inherit") {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no surface to color, so \`theme\` was dropped. It keeps the theme around it.`,
    );
  }
  if (!pictured && image) {
    console.warn(
      `[lumos] <Card variant="${variant}"> holds no image, so \`image\` was dropped. Use the cover, stacked, split or person variant to show it.`,
    );
  }
  if (pictured && !image) {
    console.warn(
      `[lumos] <Card variant="${variant}"> has no \`image\`, so it renders as a plain card.`,
    );
  }
}
---

{
  render && (hasContent || hasImage) && (
    <div
      class:list={[
        "card_wrap",
        variant !== "default" && variant,
        hasTheme && `theme-${theme}`,
        className,
      ]}
      {...rest}
    >
      {hasImage && (
        <div class="card_visual">
          <Img src={image!} alt={imageAlt} />
          {variant === "cover" && <Overlay variant="gradient" />}
        </div>
      )}
      {hasContent && (
        <div class="card_content margin-trim">
          {(eyebrow || meta) && (
            <div class="card_header">
              <Eyebrow variant={surfaced ? "tag" : "default"}>
                <Fragment set:html={eyebrow} />
              </Eyebrow>
              {meta && <p class="card_meta text-style-small">{meta}</p>}
            </div>
          )}
          <Heading tag={headingTag} variant={headingVariant}>
            <Fragment set:html={heading} />
          </Heading>
          {lead && <p class="card_lead text-style-small">{lead}</p>}
          <Paragraph variant={textVariant} class="color-faded">
            <Fragment set:html={text} />
          </Paragraph>
          {details && (
            <div class="card_details margin-trim">
              <Fragment set:html={details} />
            </div>
          )}
          {arrowOnly ? (
            <a class="card_arrow" href={buttonHref} aria-label={arrowLabel}>
              <Icon src={diagonal} variant="small" />
            </a>
          ) : (
            <ButtonWrapper>
              {buttonHref ? (
                <Button element="link" href={buttonHref} {...buttonKind}>
                  {buttonLabel}
                </Button>
              ) : (
                <Button {...buttonKind}>{buttonLabel}</Button>
              )}
            </ButtonWrapper>
          )}
        </div>
      )}
    </div>
  )
}

<style is:global>
  @layer components {
    .card_wrap {
      --_padding: var(--space-6);
      --_min-height: 20rem;
      --_visual-ratio: 3 / 2;
      --_tag-background: var(--background);
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--_padding);
      position: relative;
      background-color: var(--background-2);
      border-radius: var(--radius-main);
      overflow: clip;

      /* In a ruled grid the card sits flush on the section color, so a linked
         card lifts to the surface color while it is hovered or focused */
      .ruled > & {
        --_tag-background: var(--background-2);
      }
      .ruled > &:has(:is(.button_wrap, .card_arrow)) {
        transition: background-color var(--hover-duration) var(--hover-ease);
        &:has(:focus-visible) {
          background-color: var(--background-2);
        }
        @media (hover: hover) {
          &:hover {
            background-color: var(--background-2);
          }
        }
      }

      &.cover {
        min-height: var(--_min-height);
      }
      &:is(.stacked, .feature) {
        background-color: transparent;
        overflow: visible;
      }
      &.feature {
        border-top: var(--border-width) solid var(--border);
        border-radius: 0;
      }
      &:is(.split, .row) {
        border: var(--border-width) solid var(--border);
        transition: border-color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:has(:is(.button_wrap, .card_arrow)):hover {
            border-color: var(--background-2);
          }
        }
      }
      &.split {
        gap: 0;
        @media (width >= 48rem) {
          display: grid;
          grid-template-columns: repeat(2, minmax(0, 1fr));
          & > .card_visual {
            grid-column: 2;
            grid-row: 1;
            min-height: 100%;
          }
        }
      }
      &.person {
        --_padding: var(--space-4);
        --_visual-ratio: 4 / 5;
        background-color: transparent;
        overflow: visible;
      }
    }

    .card_visual {
      position: relative;
      width: 100%;
      flex: none;
      border-radius: inherit;
      overflow: clip;

      :is(.stacked, .split, .person) > & {
        aspect-ratio: var(--_visual-ratio);
      }

      .person > & {
        border-radius: var(--radius-main);
        background-color: var(--background-2);
      }

      .cover > & {
        position: absolute;
        inset: 0;
        height: 100%;
        pointer-events: none;
      }

      > :is(.image, .video) {
        width: 100%;
        height: 100%;
      }
    }

    /* Media fills its box, be that the whole card or the band across its top.
       The component layer puts this above the `height: auto` every image and
       video starts from. */
    .card_visual > :is(.image, .video) {
      width: 100%;
      height: 100%;
    }

    /* Buttons closing a card sit on its floor, however tall the row around it
       grows. This outranks the margin `.button-wrapper` sets for itself. */
    .card_content > :is(.button-wrapper, .card_arrow):last-child {
      margin-top: auto;
      padding-top: var(--space-6);
    }

    .row > .card_content > :is(.button-wrapper, .card_arrow):last-child {
      margin-top: 0;
      padding-top: 0;
    }

    .card_content {
      display: flex;
      flex-direction: column;
      align-items: var(--_alignment, start);
      text-align: var(--_alignment, start);
      flex-grow: 1;
      width: 100%;
      max-width: 100%;
      padding: var(--_padding);

      .cover > & {
        z-index: 1;
      }

      :is(.stacked, .feature, .person) > & {
        padding-inline: 0;
        padding-top: 0;
      }

      .person > & {
        padding-bottom: 0;
      }

      .split > & {
        justify-content: space-between;
        padding: var(--space-7) var(--space-6);
      }

      .row > & {
        flex-direction: row;
        flex-wrap: nowrap;
        justify-content: space-between;
        align-items: center;
        gap: var(--space-3) var(--space-5);
        padding: var(--space-5) var(--space-6);
      }

      .feature > & {
        padding-top: var(--space-5);
        padding-bottom: 0;
      }
    }

    .card_header {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      width: 100%;
      margin-bottom: var(--space-6);
    }

    .card_meta {
      color: var(--text-2);
    }

    .card_lead {
      margin-top: var(--space-2);
      color: var(--heading-accent);
      font-weight: var(--primary-medium);
    }

    .card_lead + .text {
      margin-top: var(--space-2);
    }

    .card_details {
      width: 100%;
      margin-top: var(--space-5);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
    }

    .card_arrow {
      display: flex;
      color: var(--text);
      transition:
        translate var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
    }

    .card_wrap:has(:is(.button_wrap, .card_arrow)) {
      :is(.button_wrap, .card_arrow)::after {
        content: "";
        position: absolute;
        inset: 0;
      }

      .card_content a:not(.button_wrap, .card_arrow) {
        position: relative;
        z-index: 1;
      }

      .image {
        transition: scale calc(var(--hover-duration) * 2) var(--hover-ease);
      }

      @media (hover: hover) {
        &:hover .image {
          scale: 1.04;
        }
        &:hover .card_arrow {
          translate: 0.125em -0.125em;
          color: var(--link-text-hover);
        }
      }
    }
  }
</style>
