---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import logo from "@/assets/logo/logo.svg";
import shield from "@/assets/icons/shield.svg";
import lock from "@/assets/icons/lock.svg";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const groups: { title: string; links: [label: string, href: string][] }[] = [
  {
    title: "Product",
    links: [
      ["Product overview", "/products"],
      ["Archiving & supervision", "/products/communications-archiving-supervision"],
      ["Employee compliance", "/products/employee-compliance"],
      ["Firm compliance", "/products/firm-compliance"],
      ["Third-party diligence", "/products/third-party-compliance"],
      ["Content reviews", "/products/marketing-compliance"],
      ["Unified books & records", "/products/platform"],
    ],
  },
  {
    title: "GreenboardGo",
    links: [
      ["Overview", "/greenboardgo"],
      ["Capabilities", "/greenboardgo#use-cases"],
      ["Go Agents", "#"],
      ["Slack & Teams", "#"],
      ["Book a demo", "/#demo"],
    ],
  },
  {
    title: "Customers",
    links: [
      ["Solutions overview", "/solutions"],
      ["Financial advisors", "/solutions/financial-advisors"],
      ["Private funds", "/solutions/private-funds"],
      ["Hedge funds", "/solutions/hedge-funds"],
      ["Broker dealers", "/solutions/broker-dealers"],
      ["Partnerships", "/partnerships"],
      ["Small firms", "/#firm-sizes"],
      ["Growing businesses", "/#firm-sizes"],
      ["Enterprise", "/#firm-sizes"],
    ],
  },
  {
    title: "Customer love",
    links: [
      ["Case studies", "/case-studies"],
      ["In their words", "/#testimonials"],
      ["Trusted by 500+ firms", "#"],
    ],
  },
  {
    title: "Company",
    links: [
      ["About", "/about"],
      ["Blog", "/blog"],
      ["Our fiduciary commitment", "#"],
      ["Security & privacy", "#"],
      ["Trust Center", "#"],
      ["Contact", "#"],
    ],
  },
];

/** Marks the link for the page being viewed, as the nav does. A link to a spot
    on a page is not the page itself, and trailing slashes are ignored. */
const here = Astro.url.pathname.replace(/\/+$/, "") || "/";
const current = (href: string) =>
  !href.includes("#") && href.replace(/\/+$/, "") === here ? "page" : undefined;
---

{
  render && (
    <footer class="footer_wrap theme-light">
      <div class="footer_inner">
        <div class="footer_top">
          <div class="footer_brand">
            <a class="footer_logo" href="/" aria-label={SITE_NAME}>
              <Icon src={logo} variant="full-width" />
            </a>
            <p class="footer_text text-style-large">
              The AI-native system of action for SEC and FINRA compliance. New
              York and Scottsdale.
            </p>
            <address class="footer_address text-style-small">
              99 Madison Ave, Floor 10
              <br />
              New York, NY 10016
            </address>
            <div class="footer_badges">
              <span class="footer_badge text-style-small">
                <Icon src={shield} variant="small" />
                SOC 2 Type 2
              </span>
              <span class="footer_badge text-style-small">
                <Icon src={lock} variant="small" />
                GDPR
              </span>
              <Button element="link" href="#" variant="link" icon="diagonal">
                LinkedIn
              </Button>
            </div>
          </div>
          <nav class="footer_groups" aria-label="Footer">
            {
              groups.map(({ title, links }) => (
                <div>
                  <h2 class="footer_group_title text-style-small">{title}</h2>
                  <ul class="footer_links">
                    {links.map(([label, href]) => (
                      <li>
                        <a class="footer_link" href={href} aria-current={current(href)}>
                          {label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </nav>
        </div>
        <div class="footer_bottom">
          <p class="footer_copyright text-style-small">
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            Greenboard, Inc. All rights reserved.
          </p>
          <ul class="footer_legal">
            <li><a class="footer_link" href="#">Privacy policy</a></li>
            <li><a class="footer_link" href="#">Terms</a></li>
            <li><a class="footer_link" href="#">Security</a></li>
            <li><a class="footer_link" href="#">Trust Center</a></li>
          </ul>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-top: var(--section-space-medium);
      padding-bottom: var(--space-6);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .footer_top {
      display: flex;
      flex-direction: column;
      gap: var(--space-8) var(--site-gutter);
      @media (width >= 64rem) {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
      }
    }

    .footer_brand {
      grid-column: 1 / span 4;
    }

    .footer_logo {
      display: block;
      width: 9.5rem;
      margin-bottom: var(--space-6);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }

    .footer_text {
      max-width: 34ch;
      margin-bottom: var(--space-4);
    }

    .footer_address {
      margin-bottom: var(--space-5);
      color: var(--text-2);
      font-style: normal;
    }

    .footer_badges {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2) var(--space-4);
      font-size: var(--text-small);
    }

    .footer_badge {
      display: inline-flex;
      align-items: center;
      gap: var(--space-1);
      padding: 0.25rem 0.625rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      font-weight: var(--primary-medium);
      &::before,
      &::after {
        content: none;
      }
      & .icon {
        color: var(--heading-accent);
      }
    }

    .footer_groups {
      display: grid;
      grid-column: 6 / span 7;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7) var(--site-gutter);
      @media (width >= 64rem) {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .footer_group_title {
      margin-bottom: var(--space-4);
      font-weight: var(--primary-bold);
    }

    .footer_links {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      font-size: var(--text-small);
    }

    .footer_link {
      color: var(--text);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--heading-accent);
        }
      }
      /* The page being viewed is underlined like a link in running text */
      &[aria-current="page"] {
        text-decoration-line: underline;
        text-decoration-thickness: var(--border-width);
        text-underline-offset: 0.2em;
      }
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: var(--space-3) var(--space-6);
      padding-top: var(--space-5);
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: var(--text-2);
    }

    .footer_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
      font-size: var(--text-small);
    }
  }
</style>
