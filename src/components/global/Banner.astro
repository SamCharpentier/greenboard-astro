---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import arrow from "@/assets/icons/arrow-full.svg";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Announcement text. Supports inline markup. */
  text?: string;
  /** Link destination. */
  href?: string;
  /** Color theme of element and its children. */
  theme?: "inherit" | "light" | "soft" | "dark" | "deep" | "brand";
}

const { render = true, text, href, theme = "soft" } = Astro.props;
---

{
  render && text && (
    <div class:list={["banner_wrap", theme !== "inherit" && `theme-${theme}`]}>
      <div class="banner_inner">
        {href ? (
          <a class="banner_link" href={href}>
            <span class="banner_text text-style-small">
              <Fragment set:html={text} />
            </span>
            <Icon class="banner_icon" src={arrow} variant="small" />
          </a>
        ) : (
          <p class="banner_text text-style-small">
            <Fragment set:html={text} />
          </p>
        )}
        <Button variant="close" label="Dismiss announcement" class="banner_close" />
      </div>
    </div>
  )
}

<script>
  for (const banner of document.querySelectorAll<HTMLElement>(".banner_wrap")) {
    banner.querySelector(".banner_close")?.addEventListener("click", () => {
      banner.hidden = true;
    });
  }
</script>

<style is:global>
  @layer components {
    .banner_wrap {
      position: relative;
      z-index: 101;
    }

    .banner_inner {
      position: relative;
      display: flex;
      justify-content: center;
      align-items: center;
      width: var(--site-width);
      max-width: var(--max-width-main);
      min-height: 2.5rem;
      margin-inline: auto;
      padding: 0.375rem 2.75rem;
      text-align: center;
    }

    .banner_link {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--heading-accent);
        }
      }
      &:focus-visible {
        color: var(--heading-accent);
      }
      & strong {
        font-weight: var(--primary-medium);
      }
    }

    .banner_icon {
      transition: translate var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        .banner_link:hover & {
          translate: 0.1875rem 0;
        }
      }
    }

    .banner_close.button_wrap {
      --button-background: transparent;
      --button-border: transparent;
      --button-text: var(--text);
      --button-background-hover: var(--background-2);
      --button-border-hover: transparent;
      --button-text-hover: var(--text);
      position: absolute;
      right: 0;
      padding: 0.5rem;
    }
  }
</style>
