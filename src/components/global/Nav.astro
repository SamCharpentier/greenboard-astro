---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import logo from "@/assets/logo/logo.svg";
import chevron from "@/assets/icons/chevron-down.svg";
import {
  menus,
  navStats,
  demoHref,
  loginHref,
  isCurrent,
} from "@/data/navigation.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const path = Astro.url.pathname;
const current = (href: string) => (isCurrent(href, path) ? "page" : undefined);
const holdsCurrent = (menu: (typeof menus)[number]) =>
  menu.groups.some((group) =>
    group.links.some((link) => isCurrent(link.href, path)),
  );
---

{
  render && (
    <header class="nav_wrap theme-dark" data-nav>
      <div class="nav_inner">
        <nav class="nav_menu" aria-label="Primary">
          <ul class="nav_menu_list">
            {menus.map((menu, index) => (
              <li class:list={["nav_menu_item", holdsCurrent(menu) && "is-current"]}>
                <button
                  class="nav_menu_button"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`nav-panel-${index}`}
                >
                  <span class="nav_menu_text text-style-main">{menu.label}</span>
                  <Icon class="nav_menu_icon" src={chevron} variant="small" />
                </button>
                <div class="nav_panel theme-light" id={`nav-panel-${index}`} hidden>
                  <div class="nav_panel_layout">
                    {menu.groups.map((group) => (
                      <div class="nav_panel_group">
                        <p class="nav_panel_label text-style-label">{group.label}</p>
                        <ul class="nav_panel_list">
                          {group.links.map((link) => (
                            <li>
                              <a
                                class="nav_panel_link text-style-main"
                                href={link.href}
                                aria-current={current(link.href)}
                              >
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                    {menu.stats && (
                      <div class="nav_panel_stats">
                        {navStats.map((stat) => (
                          <div>
                            <p class="nav_panel_stat_number text-style-h3">{stat.number}</p>
                            <p class="nav_panel_stat_label text-style-small">{stat.label}</p>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </nav>

        <a class="nav_logo" href="/" aria-label="Greenboard home">
          <Icon src={logo} variant="full-width" />
        </a>

        <div class="nav_actions">
          <a class="nav_login text-style-main" href={loginHref}>Login</a>
          <Button element="link" href={demoHref} size="small" icon="none">
            Book a demo
          </Button>
        </div>

        <button
          class="nav_toggle"
          type="button"
          aria-expanded="false"
          aria-controls="nav-mobile"
          aria-label="Open menu"
        >
          <span class="nav_toggle_line" />
          <span class="nav_toggle_line" />
        </button>

        <div class="nav_mobile" id="nav-mobile" hidden>
          <Accordion>
            {menus.map((menu) => (
              <AccordionItem heading={menu.label} headingTag="h2" headingVariant="h4">
                {menu.groups.map((group) => (
                  <Fragment>
                    {menu.groups.length > 1 && (
                      <p class="nav_mobile_label text-style-label">{group.label}</p>
                    )}
                    <ul class="nav_mobile_list">
                      {group.links.map((link) => (
                        <li>
                          <a
                            class="nav_mobile_link text-style-large"
                            href={link.href}
                            aria-current={current(link.href)}
                          >
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </Fragment>
                ))}
              </AccordionItem>
            ))}
          </Accordion>
          <div class="nav_mobile_actions">
            <Button element="link" href={demoHref}>Book a demo</Button>
            <Button element="link" href={loginHref} emphasis="secondary" icon="none">
              Login
            </Button>
          </div>
        </div>
      </div>
    </header>
  )
}

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");

  if (nav) {
    const items = [...nav.querySelectorAll<HTMLElement>(".nav_menu_item")];
    const canHover = matchMedia("(hover: hover)").matches;
    let closeTimer: number | undefined;

    const setItem = (item: HTMLElement, open: boolean) => {
      item.querySelector(".nav_menu_button")?.setAttribute("aria-expanded", String(open));
      const panel = item.querySelector<HTMLElement>(".nav_panel");
      if (panel) panel.hidden = !open;
    };
    const closeAll = (except?: HTMLElement) =>
      items.forEach((item) => item !== except && setItem(item, false));

    for (const item of items) {
      const button = item.querySelector<HTMLButtonElement>(".nav_menu_button");
      if (!button) continue;
      let hoverOpenedAt = 0;
      button.addEventListener("click", () => {
        /* A click right after the pointer opened the panel keeps it open */
        if (Date.now() - hoverOpenedAt < 600) return;
        const open = button.getAttribute("aria-expanded") !== "true";
        closeAll(item);
        setItem(item, open);
      });
      if (canHover) {
        item.addEventListener("mouseenter", () => {
          window.clearTimeout(closeTimer);
          if (button.getAttribute("aria-expanded") !== "true") hoverOpenedAt = Date.now();
          closeAll(item);
          setItem(item, true);
        });
        item.addEventListener("mouseleave", () => {
          closeTimer = window.setTimeout(() => setItem(item, false), 180);
        });
      }
      item.addEventListener("focusout", (event) => {
        if (!item.contains(event.relatedTarget as Node)) setItem(item, false);
      });
      item.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => setItem(item, false)),
      );
    }

    const toggle = nav.querySelector<HTMLButtonElement>(".nav_toggle");
    const mobile = nav.querySelector<HTMLElement>(".nav_mobile");
    const setMenu = (open: boolean) => {
      if (!toggle || !mobile) return;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobile.hidden = !open;
      document.documentElement.style.overflow = open ? "hidden" : "";
      requestMatch();
    };
    toggle?.addEventListener("click", () =>
      setMenu(toggle.getAttribute("aria-expanded") !== "true"),
    );
    mobile?.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => setMenu(false)),
    );
    matchMedia("(width >= 66rem)").addEventListener("change", (event) => {
      if (event.matches) setMenu(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      const openItem = items.find(
        (item) => item.querySelector(".nav_menu_button")?.getAttribute("aria-expanded") === "true",
      );
      if (openItem) {
        setItem(openItem, false);
        openItem.querySelector<HTMLButtonElement>(".nav_menu_button")?.focus();
      }
      if (toggle?.getAttribute("aria-expanded") === "true") {
        setMenu(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (!nav.contains(event.target as Node)) closeAll();
    });

    /* The nav takes the theme of what sits under its bottom edge, and turns
       transparent over a section marked data-nav-transparent. An open mobile
       menu always keeps the bar filled. */
    const themes = ["theme-light", "theme-soft", "theme-dark", "theme-deep", "theme-brand"];
    const themed = () =>
      [...document.querySelectorAll<HTMLElement>("main .section, [data-open-theme]")].filter(
        (element) => themes.some((name) => element.classList.contains(name)),
      );
    let currentSection: HTMLElement | null = null;
    let currentFill: number | null = null;
    let frame: number | null = null;

    const match = () => {
      frame = null;
      const line = nav.getBoundingClientRect().bottom + 1;
      const candidates = themed();
      const hits = candidates.filter((element) => {
        const box = element.getBoundingClientRect();
        return box.top <= line && box.bottom > line;
      });
      const section =
        hits[hits.length - 1] ??
        candidates.find((element) => element.getBoundingClientRect().top > line) ??
        null;
      if (section && section !== currentSection) {
        currentSection = section;
        const theme = themes.find((name) => section.classList.contains(name));
        nav.classList.remove(...themes);
        if (theme) nav.classList.add(theme);
      }
      const menuOpen = toggle?.getAttribute("aria-expanded") === "true";
      const fill = section?.hasAttribute("data-nav-transparent") && !menuOpen ? 0 : 1;
      if (fill !== currentFill) {
        currentFill = fill;
        nav.style.setProperty("--_fill", String(fill));
      }
    };
    const requestMatch = () => {
      if (frame === null) frame = requestAnimationFrame(match);
    };
    addEventListener("scroll", requestMatch, { passive: true });
    addEventListener("resize", requestMatch);
    new ResizeObserver(requestMatch).observe(document.body);
    match();
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      --_fill: 1;
      position: sticky;
      top: 0;
      z-index: 20;
      border-bottom: var(--border-width) solid
        color-mix(in srgb, var(--border) calc(100% * var(--_fill)), transparent);
      background-color: color-mix(
        in srgb,
        var(--background) calc(100% * var(--_fill)),
        transparent
      );
      color: var(--text);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
    }

    .nav_inner {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto auto;
      align-items: center;
      gap: var(--space-3);
      width: var(--site-width);
      max-width: var(--max-width-main);
      min-height: var(--nav-height);
      margin-inline: auto;
      @media (width >= 66rem) {
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        gap: var(--space-5);
      }
    }

    .nav_menu {
      display: none;
      justify-self: start;
      @media (width >= 66rem) {
        display: block;
      }
    }

    .nav_menu_list {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      margin-left: calc(var(--space-3) * -1);
    }

    .nav_menu_item {
      position: relative;
    }

    .nav_menu_button {
      display: flex;
      align-items: center;
      gap: 0.375rem;
      min-height: var(--button-size-small);
      padding: 0 var(--space-3);
      border-radius: var(--radius-round);
      color: var(--text-2);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--background-2);
          color: var(--text);
        }
      }
      &:focus-visible,
      &[aria-expanded="true"] {
        background-color: var(--background-2);
        color: var(--text);
      }
    }

    .nav_menu_item.is-current .nav_menu_text {
      color: var(--accent);
    }

    .nav_menu_icon {
      transition: rotate var(--hover-duration) var(--hover-ease);
      .nav_menu_button[aria-expanded="true"] & {
        rotate: 180deg;
      }
    }

    .nav_panel {
      position: absolute;
      top: calc(100% + var(--space-3));
      left: 0;
      z-index: 5;
      padding: var(--space-5);
      border-radius: var(--radius-main);
      box-shadow: var(--shadow-float);
    }

    .nav_panel_layout {
      display: flex;
      gap: var(--space-7);
    }

    .nav_panel_group {
      display: flex;
      flex-direction: column;
      min-width: 11rem;
    }

    .nav_panel_label {
      margin-bottom: var(--space-3);
      color: var(--text-2);
    }

    .nav_panel_list {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
      margin-left: calc(var(--space-2) * -1);
    }

    .nav_panel_link {
      display: block;
      padding: 0.4375rem var(--space-2);
      border-radius: var(--radius-small);
      white-space: nowrap;
      transition: background-color var(--duration-fast) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--background-2);
        }
      }
      &:focus-visible {
        background-color: var(--background-2);
      }
      &[aria-current="page"] {
        background-color: var(--background-2);
        color: var(--accent);
      }
    }

    .nav_panel_stats {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      width: 13rem;
      padding-left: var(--space-6);
      border-left: var(--border-width) solid var(--border);
    }

    .nav_panel_stat_number {
      margin-bottom: var(--space-2);
      font-weight: var(--primary-light);
      font-variant-numeric: tabular-nums;
    }

    .nav_panel_stat_label {
      color: var(--text-2);
    }

    .nav_logo {
      display: block;
      justify-self: start;
      width: 8.5rem;
      color: var(--text);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (width >= 66rem) {
        justify-self: center;
        width: 9.5rem;
      }
    }

    .nav_actions {
      display: none;
      justify-content: flex-end;
      align-items: center;
      gap: var(--space-4);
      @media (width >= 29rem) {
        display: flex;
      }
    }

    .nav_login {
      display: none;
      color: var(--text-2);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
      &:focus-visible {
        color: var(--text);
      }
      @media (width >= 66rem) {
        display: block;
      }
    }

    .nav_toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 0.3125rem;
      width: var(--button-size-small);
      aspect-ratio: 1 / 1;
      border: var(--border-width) solid var(--button-2-border);
      border-radius: var(--radius-round);
      color: var(--text);
      @media (width >= 66rem) {
        display: none;
      }
    }

    .nav_toggle_line {
      width: 1rem;
      height: var(--icon-stroke-width);
      border-radius: var(--radius-round);
      background-color: currentcolor;
      transition: translate var(--hover-duration) var(--hover-ease),
        rotate var(--hover-duration) var(--hover-ease);
      .nav_toggle[aria-expanded="true"] &:first-child {
        translate: 0 0.2031rem;
        rotate: 45deg;
      }
      .nav_toggle[aria-expanded="true"] &:last-child {
        translate: 0 -0.2031rem;
        rotate: -45deg;
      }
    }

    .nav_mobile {
      position: absolute;
      top: 100%;
      left: calc(var(--site-margin) * -1);
      right: calc(var(--site-margin) * -1);
      height: calc(100svh - var(--nav-height));
      padding: var(--space-4) var(--site-margin) var(--space-8);
      border-top: var(--border-width) solid var(--border);
      background-color: var(--background);
      color: var(--text);
      overflow-y: auto;
      overscroll-behavior: contain;
      @media (width >= 66rem) {
        display: none;
      }
      .accordion_wrap {
        border-top: 0;
      }
    }

    .nav_mobile_label {
      margin: var(--space-4) 0 var(--space-1);
      color: var(--accent);
    }

    .nav_mobile_list {
      display: flex;
      flex-direction: column;
    }

    .nav_mobile_link {
      display: block;
      padding-block: var(--space-2);
      color: var(--text-2);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
      &[aria-current="page"] {
        color: var(--accent);
      }
    }

    .nav_mobile_actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-3);
      margin-top: var(--space-7);
    }
  }
</style>
