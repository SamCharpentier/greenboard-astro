          </ContentWrapper>
        </SystemBlock>
        <SystemBlock
          heading="Auto width"
          text='<code>variant="auto-width"</code>. Heading on the left, the second column on the right, as on most homepage sections.'
          variant="panel"
        >
          <ContentWrapper variant="auto-width">
            <Heading tag="h4" variant="h2" maxWidth={16}
              >Right-sized for your firm</Heading
            >
            <Paragraph slot="column2" maxWidth={44} class="color-faded">
              The same records backbone whether you’re one person or a
              multi-entity organization, configured to the program you actually
              run.
            </Paragraph>
          </ContentWrapper>
        </SystemBlock>
        <SystemBlock
          heading="Centered"
          text="<code>centered</code> on the stack variant. For closing calls to action and statements."
          variant="panel"
          theme="dark"
        >
          <ContentWrapper centered>
            <Heading tag="h4" variant="h2" maxWidth={18} class="heading-accent">
              Built for <strong>AI-native</strong> compliance teams.
            </Heading>
            <ButtonWrapper>
              <Button>Book a demo</Button>
            </ButtonWrapper>
          </ContentWrapper>
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="longform"
        number="15"
        heading="Stories and articles"
        text="Case studies, blog posts and partner pages share one reading layout: the text sits at a reading measure in the middle of the page, with the table of contents beside it when the page has one. Headings inside the text step down a size, so a narrow column keeps its rhythm."
      >
        <SystemBlock
          heading="Table of contents"
          text="Lists the page's sections, stays in view while reading and marks the one on screen. Used on case studies."
        >
          <Grid medium={2}>
            <TableOfContents
              headings={[
                { slug: "longform", text: "About Root Financial" },
                { slug: "build", text: "The Challenge" },
                { slug: "build", text: "The Solution" },
              ]}
            />
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Lead quote"
          text='<code>Quote variant="card"</code> with a portrait. Opens a case study.'
        >
          <Grid medium={2}>
            <Quote
              variant="card"
              name="Alex Stickelman"
              position="CCO & COO, Root Financial"
              image={alexStickelman}
            >
              Whatever we came up with for marketing reviews, it had to move as
              fast as the content creators moved.
            </Quote>
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Story quote card"
          text='<code>Card variant="quote"</code>: the customer logo, the lead quote with a portrait, and the headline figure as a <code>Stat size="small"</code> in its slot. The whole card links to the story. In a grid the cards share their rows, so the rules above the figures line up. Used for related stories on case study and solution pages.'
        >
          <Grid medium={2} class="gap-3">
            <Card
              variant="quote"
              image={rootLogo}
              imageAlt="Root Financial"
              quote="Whatever we came up with for marketing reviews, it had to move as fast as the content creators moved."
              name="Alex Stickelman"
              position="CCO & COO, Root Financial"
              portrait={alexStickelman}
              buttonLabel="Read the Root Financial story"
              buttonHref="/case-studies/root-financial"
            >
              <Stat size="small" number="24" unit="hours" label="Est. weekly time saved on marketing review" />
            </Card>
            <Card
              variant="quote"
              image={jmgLogo}
              imageAlt="JMG Financial Group"
              quote="I can’t say they like compliance, but I can tell you that advisors love Greenboard."
              name="Adam Boyer"
              position="COO & CCO, JMG Financial Group"
              portrait={adamBoyer}
              buttonLabel="Read the JMG Financial Group story"
              buttonHref="/case-studies/jmg-financial-group"
            >
              <Stat size="small" number="$7.5B" label="Assets Under Management" />
            </Card>
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Filter"
          text='<code>Filter</code> shows the items in its slot that carry a matching <code>data-filter</code>. Options toggle, so several can be on at once, and <code>Show all</code> clears them. The choice is kept in the address under the filter&rsquo;s <code>id</code>. With <code>pageSize</code> set, <code>Load more</code> adds that many at a time. The case study list filters by firm type and shows six at a time; this sample shows two.'
        >
          <Filter id="sample-filter" pageSize={2}>
            <FilterOption slot="options" value="financial-advisors">Financial Advisors</FilterOption>
            <FilterOption slot="options" value="private-funds">Private Funds</FilterOption>
            <FilterOption slot="options" value="hedge-funds">Hedge Funds</FilterOption>
            <Grid medium={2} class="gap-3">
              <Card variant="row" eyebrow="Financial Advisors" heading="Sample story one" data-filter="financial-advisors" />
              <Card variant="row" eyebrow="Private Funds" heading="Sample story two" data-filter="private-funds" />
              <Card variant="row" eyebrow="Hedge Funds" heading="Sample story three" data-filter="hedge-funds" />
              <Card variant="row" eyebrow="Financial Advisors" heading="Sample story four" data-filter="financial-advisors" />
              <Card variant="row" eyebrow="Private Funds" heading="Sample story five" data-filter="private-funds" />
            </Grid>
          </Filter>
        </SystemBlock>
        <SystemBlock
          heading="Filter as a menu"
          text='<code>variant="menu"</code> folds the options into a panel that opens from <code>Filter by</code>, and names the choice on the button once it closes. Escape closes it. Used for the partner directory.'
        >
          <Filter id="sample-menu" variant="menu" allLabel="All">
            <FilterOption slot="options" value="compliance-services">Compliance Services</FilterOption>
            <FilterOption slot="options" value="data-custody">Data & Custody</FilterOption>
            <Grid medium={2} class="gap-3">
              <Card variant="row" eyebrow="Compliance Services" heading="Sample partner one" data-filter="compliance-services" />
              <Card variant="row" eyebrow="Data & Custody" heading="Sample partner two" data-filter="data-custody" />
            </Grid>
          </Filter>
        </SystemBlock>
        <SystemBlock
          heading="Byline and sharing"
          text="<code>Byline</code> names the author with a portrait, or initials without one. <code>Share</code> copies the page address or opens LinkedIn and Facebook."
          variant="panel"
        >
          <ContentWrapper variant="auto-width" class="align-items-center">
            <Byline name="Dave Feldman" position="Co-founder and CEO" image={daveFeldman} />
            <Share slot="column2" url="https://www.greenboard.com/blog/" />
          </ContentWrapper>
        </SystemBlock>
        <SystemBlock
          heading="Video"
          text="<code>VideoEmbed</code> shows a still and loads the Vimeo player only when someone presses play."
        >
          <VideoEmbed
            src="https://player.vimeo.com/video/1011498413"
            title="The Trust Podcast Episode 1: Michael Kitces"
            poster={podcastStill}
          />
        </SystemBlock>
        <SystemBlock
          heading="Customer logo"
          text="On a story page the logo is sized by area, so a wide wordmark and a square crest read at the same weight."
          variant="panel"
        >
          <Img src={rootLogo} alt="Root Financial" variant="densities" height={60} transparent />
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="build"
        number="16"
        heading="Astro build"
        text="Where things live in the repository, and every component with its variants and props, read from the source each time the site builds."
      >
        <SystemBlock heading="Files">
          <SystemTable
            label="Files"
            head={["Path", "What it holds"]}
            rows={[
              [
                "<code>src/styles/base.css</code>",
                "Tokens, themes, text styles and element defaults.",
              ],
              [
                "<code>src/styles/patterns.css</code>",
                "Shared patterns such as the heading accent, eyebrow spacing and margin trim.",
              ],
              [
                "<code>src/styles/utilities.css</code>",
                "Single-purpose classes for one-off changes.",
              ],
              [
                "<code>src/components</code>",
                "One file per component, holding its markup, styles and script.",
              ],
              [
                "<code>src/pages</code>",
                "One file per page, assembled from components.",
              ],
              [
                "<code>src/assets</code>",
                "Images and icons, optimized when the site builds.",
              ],
              [
                "<code>LUMOS.md</code>",
                "The rules for adding pages, components and styles.",
              ],
            ]}
          />
        </SystemBlock>
        <SystemBlock
          heading="Components"
          text="Listed from the component files. Hover a prop for its description."
        >
          <SystemProps />
        </SystemBlock>
        <SystemBlock heading="Adding to the system">
          <SystemRules
            use={[
              "Build pages from existing components before writing new markup.",
              "Add a variant to a component before creating a new one.",
              "Put a new value in <code>base.css</code> as a token, then read the token.",
            ]}
            avoid={[
              "Styles on a page. They belong in the component that needs them.",
              "The same class or prop repeated on every instance. Change the default instead.",
              "Lengths in <code>px</code>.",
            ]}
          />
        </SystemBlock>
      </SystemChapter>
    </SystemLayout>
  </Section>
</Layout>
