---
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Facts from "@/components/item/Facts.astro";
import List from "@/components/item/List.astro";
import LogoList from "@/components/item/LogoList.astro";
import Quote from "@/components/item/Quote.astro";
import Stat from "@/components/item/Stat.astro";
import Accordion from "@/components/interactive/Accordion.astro";
import AccordionItem from "@/components/interactive/AccordionItem.astro";
import Tabs from "@/components/interactive/Tabs.astro";
import TabLink from "@/components/interactive/TabLink.astro";
import Slider from "@/components/interactive/Slider.astro";
import Marquee from "@/components/interactive/Marquee.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Icon from "@/components/media/Icon.astro";
import Img from "@/components/media/Img.astro";
import GoMark from "@/components/media/GoMark.astro";
import CasePanel from "@/components/content/CasePanel.astro";
import Byline from "@/components/item/Byline.astro";
import Share from "@/components/interactive/Share.astro";
import TableOfContents from "@/components/interactive/TableOfContents.astro";
import Filter from "@/components/interactive/Filter.astro";
import LogoField from "@/components/section/LogoField.astro";
import LogoMarquee from "@/components/content/LogoMarquee.astro";
import yCombinator from "@/assets/images/investors/y-combinator.png";
import base10 from "@/assets/images/investors/base10.png";
import generalCatalyst from "@/assets/images/investors/general-catalyst.svg";
import wayfinder from "@/assets/images/investors/wayfinder.png";
import handshake from "@/assets/icons/handshake.svg";
import landmark from "@/assets/icons/landmark.svg";
import partnerKroll from "@/assets/images/partners/kroll.png";
import partnerAws from "@/assets/images/partners/aws.png";
import partnerFirmScribe from "@/assets/images/partners/firmscribe.png";
import partnerMicrosoft from "@/assets/images/partners/microsoft.png";
import partnerMorningstar from "@/assets/images/partners/morningstar.png";
import FilterOption from "@/components/interactive/FilterOption.astro";
import VideoEmbed from "@/components/media/VideoEmbed.astro";
import rootLogo from "@/assets/images/case-studies/root-financial.svg";
import jmgLogo from "@/assets/images/case-studies/jmg-financial-group.webp";
import alexStickelman from "@/assets/images/people/alex-stickelman.jpeg";
import adamBoyer from "@/assets/images/people/adam-boyer.jpg";
import cabCover from "@/assets/images/blog/greenboards-customer-advisory-board.jpg";
import podcastStill from "@/assets/images/blog/the-trust-podcast-episode-1-michael-kitces.jpg";
import SystemLayout from "@/components/content/system/SystemLayout.astro";
import SystemChapter from "@/components/content/system/SystemChapter.astro";
import SystemBlock from "@/components/content/system/SystemBlock.astro";
import SystemSwatch from "@/components/content/system/SystemSwatch.astro";
import SystemTable from "@/components/content/system/SystemTable.astro";
import SystemTheme from "@/components/content/system/SystemTheme.astro";
import SystemTokens from "@/components/content/system/SystemTokens.astro";
import SystemType from "@/components/content/system/SystemType.astro";
import SystemScale from "@/components/content/system/SystemScale.astro";
import SystemSample from "@/components/content/system/SystemSample.astro";
import SystemRules from "@/components/content/system/SystemRules.astro";
import SystemProps from "@/components/content/system/SystemProps.astro";
import { range, resolve } from "@/utils/tokens.ts";
import records from "@/assets/icons/records.svg";
import shield from "@/assets/icons/shield.svg";
import lock from "@/assets/icons/lock.svg";
import microsoft from "@/assets/images/about/logo-microsoft.png";
import firmscribe from "@/assets/images/about/logo-firmscribe.png";
import celltrust from "@/assets/images/about/logo-celltrust.png";
import kroll from "@/assets/images/about/logo-kroll.png";
import morningstar from "@/assets/images/about/logo-morningstar.png";
import aws from "@/assets/images/about/logo-aws.png";
import daveFeldman from "@/assets/images/about/dave-feldman.jpg";
import edSchembor from "@/assets/images/about/ed-schembor.jpg";
import daveFrisone from "@/assets/images/about/dave-frisone.jpg";
import financialAdvisors from "@/assets/images/solutions/financial-advisors.jpg";
import privateFunds from "@/assets/images/solutions/private-funds.jpg";
import hedgeFunds from "@/assets/images/solutions/hedge-funds.jpg";

const investorLogos = [
  { image: yCombinator, name: "Y Combinator" },
  { image: base10, name: "Base10" },
  { image: generalCatalyst, name: "General Catalyst" },
  { image: wayfinder, name: "Wayfinder" },
];
---

<Layout
  title="Web system"
  description="The Greenboard web system: color, themes, type, spacing and every component, read from the site's own code."
>
  {/* Header */}
  <HeroPage eyebrow="Reference" heading="Greenboard web system" maxWidth={14}>
    <Paragraph variant="large">
      Color, type, spacing, themes and components for greenboard.com. Every
      example on this page is the live component reading the live tokens, so the
      page changes when the site does.
    </Paragraph>
    <Facts>
      <div>
        <dt>Framework</dt>
        <dd>Lumos for Astro</dd>
      </div>
      <div>
        <dt>Typeface</dt>
        <dd>Outfit, four weights</dd>
      </div>
      <div>
        <dt>Themes</dt>
        <dd>Light, Soft, Dark, Deep, Brand</dd>
      </div>
      <div>
        <dt>Prepared by</dt>
        <dd>Official Partner</dd>
      </div>
    </Facts>
  </HeroPage>

  {/* Chapters */}
  <Section theme="light">
    <SystemLayout
      chapters={[
        { id: "overview", label: "How it works" },
        { id: "color", label: "Color" },
        { id: "themes", label: "Themes" },
        { id: "type", label: "Typography" },
        { id: "spacing", label: "Spacing" },
        { id: "layout", label: "Layout" },
        { id: "shape", label: "Shape and depth" },
        { id: "motion", label: "Motion" },
        { id: "buttons", label: "Buttons and links" },
        { id: "forms", label: "Forms" },
        { id: "labels", label: "Labels and lists" },
        { id: "cards", label: "Cards" },
        { id: "data", label: "Data" },
        { id: "interactive", label: "Interactive" },
        { id: "headers", label: "Section heads" },
        { id: "longform", label: "Stories and articles" },
        { id: "build", label: "Astro build" },
      ]}
    >
      <SystemChapter
        id="overview"
        number="00"
        heading="How the system works"
        text="Every color, size and space comes from a named token, and components take their colors from the theme around them. Change a token and every component that reads it follows."
      >
        <SystemBlock
          heading="Five layers"
          text="Each layer only uses the ones below it."
        >
          <SystemTable
            label="Layers"
            head={["Layer", "What it holds", "Where it lives"]}
            rows={[
              [
                "1. Tokens",
                "Swatches, type sizes, spacing, radius, motion. Raw values, named once.",
                "<code>src/styles/base.css</code>",
              ],
              [
                "2. Themes",
                "Light, Soft, Dark, Deep and Brand remap the color tokens for everything inside them.",
                "<code>theme-*</code> classes in <code>base.css</code>",
              ],
              [
                "3. Patterns and utilities",
                "Text styles, heading accent and margin trim, plus single-purpose classes for one-off changes.",
                "<code>patterns.css</code>, <code>utilities.css</code>",
              ],
              [
                "4. Components",
                "Buttons, cards, forms, accordion, tabs. They only read theme tokens.",
                "<code>src/components</code>",
              ],
              [
                "5. Pages",
                "Sections assembled from components, with the banner, nav and footer shared by every page.",
                "<code>src/pages</code>",
              ],
            ]}
          />
        </SystemBlock>
        <SystemBlock heading="Principles">
          <Grid medium={2} large={3} class="gap-row-7">
            <Card
              variant="feature"
              headingTag="h4"
              heading="Midnight and Ivory lead"
              text="Most of any page is Ivory with Midnight text, or the reverse. Accents are small and deliberate, as the brand book asks."
            />
            <Card
              variant="feature"
              headingTag="h4"
              heading="Emerald means action"
              text="Primary buttons are Emerald on every theme except Brand, where they turn Midnight. Lemon Lime is kept for figures and text selection."
            />
            <Card
              variant="feature"
              headingTag="h4"
              heading="Light type is for large sizes"
              text="Outfit Light carries Display, H1 and H2. Reading text stays Regular, and labels and buttons use Medium."
            />
            <Card
              variant="feature"
              headingTag="h4"
              heading="Flat by default"
              text="Surfaces are separated by tone and one hairline. Only floating elements like menus get a shadow."
            />
            <Card
              variant="feature"
              headingTag="h4"
              heading="Components never pick a color"
              text="A component reads its theme. Put it in a Dark section and it adapts without a variant."
            />
          </Grid>
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="color"
        number="01"
        heading="Color"
        text="The brand book palette. Midnight Green and Ivory carry the pages, the accents mark moments, and two tonal ranges add depth without new hues."
      >
        <SystemBlock
          heading="Core"
          text="Midnight Green and Ivory are the brand. They should be recognizable at a glance."
        >
          <Grid xsmall={2} large={3}>
            <SystemSwatch
              name="Midnight Green"
              token="midnight-800"
              note="Text on light surfaces, dark sections, primary button hover."
            />
            <SystemSwatch
              name="Ivory"
              token="ivory-50"
              note="Page background, text on dark surfaces."
            />
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Accents"
          text="Used sparingly, each with one job."
        >
          <Grid xsmall={2} large={4}>
            <SystemSwatch
              name="Dark Teal"
              token="teal"
              note="Accent on light surfaces: heading accent, icons, links on hover."
            />
            <SystemSwatch
              name="Emerald"
              token="emerald"
              note="The action color. Primary buttons, accent on dark surfaces."
            />
            <SystemSwatch
              name="Beige"
              token="ivory-200"
              note="Soft sections that break up a long page."
            />
            <SystemSwatch
              name="Lemon Lime"
              token="lime"
              note="Figures on dark surfaces and text selection. Never text on light."
            />
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Tonal ranges"
          text="From the brand book. Used for surfaces and product visuals instead of new colors."
        >
          <Grid xsmall={3} medium={6}>
            <SystemSwatch variant="compact" token="midnight-900" />
            <SystemSwatch variant="compact" token="midnight-800" />
            <SystemSwatch variant="compact" token="midnight-700" />
            <SystemSwatch variant="compact" token="midnight-600" />
            <SystemSwatch variant="compact" token="midnight-500" />
            <SystemSwatch variant="compact" token="midnight-400" />
          </Grid>
          <Grid xsmall={3} medium={6}>
            <SystemSwatch variant="compact" token="ivory-50" />
            <SystemSwatch variant="compact" token="ivory-100" />
            <SystemSwatch variant="compact" token="ivory-200" />
            <SystemSwatch variant="compact" token="ivory-300" />
            <SystemSwatch variant="compact" token="ivory-400" />
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Logo"
          text="The green of the G in the logo. It stays in the logo and is never used for interface color."
        >
          <Grid xsmall={2} large={4}>
            <SystemSwatch name="Logo green" token="logo" />
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Contrast"
          text="Worked out from the theme tokens against WCAG 2.2 each time the site builds. Body text needs 4.5:1, large text and interface parts need 3:1."
        >
          <SystemTokens variant="contrast" />
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="themes"
        number="02"
        heading="Themes"
        text="A theme is a set of color tokens applied with one class. Every component reads the theme it sits in, so a button, card or link looks right on any surface without a variant of its own."
      >
        <SystemBlock
          heading="Five themes"
          text="Set with the <code>theme</code> prop on a Section, or a <code>theme-*</code> class on any element. Themes nest: a Light card inside a Soft section switches back to Light values."
        >
          <SystemTheme
            theme="light"
            name="Light"
            surface="Ivory"
            text="Default page surface. Most content sections."
          />
          <SystemTheme
            theme="soft"
            name="Soft"
            surface="Beige"
            text="Alternating sections, and card groups that need a surface behind them."
          />
          <SystemTheme
            theme="dark"
            name="Dark"
            surface="Midnight Green"
            text="Product sections and the closing call to action."
          />
          <SystemTheme
            theme="deep"
            name="Deep"
            surface="Midnight 900"
            text="One step darker than Dark, for a section that sits next to a Dark one."
          />
          <SystemTheme
            theme="brand"
            name="Brand"
            surface="Emerald"
            text="Small elements only, like the Go tag. Never a full section."
            heading="Brand is for small moments."
          />
        </SystemBlock>
        <SystemBlock
          heading="Theme tokens"
          text="The color tokens every component reads, per theme, as set in <code>base.css</code>."
        >
          <SystemTokens variant="themes" />
        </SystemBlock>
        <SystemBlock
          heading="Heading accent"
          text="Wrap the words to stress in <code>strong</code> inside a heading with <code>heading-accent</code>. The color changes, the weight does not. A rare second stress goes in <code>em</code> and takes the highlight, as in the About hero."
          variant="panel"
        >
          <Paragraph variant="h2" maxWidth={24} class="heading-accent">
            Built for <strong>AI-native</strong> compliance teams.
          </Paragraph>
        </SystemBlock>
        <SystemBlock variant="panel" theme="dark">
          <Paragraph variant="h2" maxWidth={24} class="heading-accent">
            AI to increase <strong>human agency</strong> in support of a <em
              >culture of compliance</em
            >
          </Paragraph>
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="type"
        number="03"
        heading="Typography"
        text="One family, Outfit. Sizes are fluid between a 320px and a 1440px wide screen, so headings scale smoothly instead of jumping at breakpoints."
      >
        <SystemBlock
          heading="Outfit"
          text="Self-hosted as a variable font. Light for large headings, Regular for reading, Medium for labels and buttons."
        >
          <Grid small={2} large={4}>
            <SystemSample
              variant="type-light"
              label="Light 300"
              note="Display, H1, H2"
            />
            <SystemSample
              variant="type-regular"
              label="Regular 400"
              note="H3 to H5, reading text"
            />
            <SystemSample
              variant="type-medium"
              label="Medium 500"
              note="H6, labels, buttons"
            />
            <SystemSample
              variant="type-bold"
              label="Semibold 600"
              note="Footer group titles"
            />
          </Grid>
        </SystemBlock>
        <SystemBlock
          heading="Type scale"
          text="Ten text styles, read from <code>base.css</code>. Set the style with <code>variant</code> and keep the tag semantic: an <code>h2</code> can use the H4 style."
        >
          <div>
            <SystemType variant="display" note="One per page, the hero."
              >Compliance is mandatory,</SystemType
            >
            <SystemType variant="h1" note="Page titles on inner pages."
              >Suffering is not.</SystemType
            >
            <SystemType variant="h2" note="Section headings."
              >Our principles</SystemType
            >
            <SystemType variant="h3" note="Module titles, large quotes."
              >Archiving & Supervision</SystemType
            >
            <SystemType variant="h4" note="Card titles."
              >A full program without a full team.</SystemType
            >
            <SystemType variant="h5" note="Small card titles, list headings."
              >Financial Advisors</SystemType
            >
            <SystemType variant="h6" note="Group titles."
              >Right-sized for your firm</SystemType
            >
            <SystemType variant="large" note="Intro paragraphs under a heading."
              >Configured during implementation to match your team’s roles,
              groups, and the exact standards of your program.</SystemType
            >
            <SystemType variant="main" note="Body copy and buttons."
              >Supervision runs on a risk graph you configure, combining AI
              rules and lexicons, so what gets escalated reflects your program,
              not a vendor’s default keyword list.</SystemType
            >
            <SystemType variant="small" note="Card text, captions, form help."
              >Unified recordkeeping designed for CCO peace of mind, so an exam
              request becomes a query instead of a fire drill.</SystemType
            >
          </div>
        </SystemBlock>
        <SystemBlock
          heading="Measure"
          text="Set <code>maxWidth</code> on a Heading or Paragraph for its line length in characters. Body copy reads best at 45 to 70 characters, headings between 12 and 24."
          variant="panel"
        >
          <ContentWrapper>
            <Heading tag="h4" variant="h3" maxWidth={16}
              >Right-sized for your firm</Heading
            >
            <Paragraph maxWidth={48} class="color-faded">
              The same records backbone whether you’re one person or a
              multi-entity organization, configured to the program you actually
              run.
            </Paragraph>
          </ContentWrapper>
        </SystemBlock>
        <SystemBlock
          heading="Rich text"
          text="Long copy and CMS content go in <code>RichText</code>, which spaces headings, paragraphs and lists on its own. Links inside text are underlined and take the accent on hover."
          variant="panel"
        >
          <RichText>
            <h4>Every channel, one record.</h4>
            <p>
              Email, chat, text, voice, and social, captured where your people
              actually talk, then written once to a WORM, 17a-4 compliant
              record.
            </p>
            <ul>
              <li>Gmail, Outlook, Slack, Teams and WhatsApp</li>
              <li>Risk graph built from your own AI rules and lexicons</li>
              <li>A reviewable trail behind every decision</li>
            </ul>
            <p>Read more in the <a href="#type">Trust Center</a>.</p>
          </RichText>
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="spacing"
        number="04"
        heading="Spacing"
        text="Eight steps for components and four for sections, all fluid. Every gap, padding and margin comes from this list."
      >
        <SystemBlock
          heading="Space scale"
          text="Tokens <code>--space-1</code> to <code>--space-8</code>. Bars show the value at the current screen width."
        >
          <SystemScale
            rows={[
              { token: "space-1", note: "Icon to text" },
              { token: "space-2", note: "Tight groups, button gaps" },
              { token: "space-3", note: "Label to title, list items" },
              { token: "space-4", note: "Paragraph rhythm" },
              { token: "space-5", note: "Heading to text, compact padding" },
              { token: "space-6", note: "Card padding, block gaps" },
              { token: "space-7", note: "Space above headings, panel padding" },
              { token: "space-8", note: "Section head to content" },
            ]}
          />
        </SystemBlock>
        <SystemBlock
          heading="Section spacing"
          text="Top and bottom padding of a Section, set with <code>paddingTop</code> and <code>paddingBottom</code>. Medium is the default."
        >
          <SystemScale
            rows={[
              { token: "section-space-small", note: "Logo rows, dense bands" },
              { token: "section-space-medium", note: "Default section" },
              { token: "section-space-large", note: "Closing call to action" },
              {
                token: "section-space-nav-overlap",
                note: "First section, when it runs under the nav",
              },
            ]}
          />
        </SystemBlock>
        <SystemBlock heading="Rhythm">
          <SystemRules
            use={[
              "Keep related items tight (space 2 to 3) and separate groups generously (space 6 to 8).",
              "Leave more space above a heading than below it. Text styles set this through their margin tokens.",
              "Use gap on flex and grid parents. Use margins only between text elements.",
            ]}
            avoid={[
              "Mixing space steps inside one component to fix alignment by eye.",
              "Section padding smaller than the gap between its own children.",
              "Lengths in <code>px</code>. Sizes are in <code>rem</code>, text widths in <code>ch</code>.",
            ]}
          />
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="layout"
        number="05"
        heading="Layout"
        text="Content sits in a Section, the Section centers it in a container, and components change layout at three breakpoints."
      >
        <SystemBlock
          heading="Containers"
          text="Containers center themselves and never touch the screen edge."
        >
          <SystemTable
            label="Containers"
            head={["Token", "Value", "Use"]}
            rows={[
              [
                "<code>--max-width-main</code>",
                "1440px",
                "Default for every section.",
              ],
              [
                "<code>--max-width-small</code>",
                "70rem, 1120px",
                "Narrow content such as legal pages and articles.",
              ],
              [
                "<code>--site-margin</code>",
                range("site-margin"),
                "Space between the content and the screen edge.",
              ],
              [
                "<code>--site-gutter</code>",
                range("site-gutter"),
                "Gap between grid columns.",
              ],
            ]}
          />
        </SystemBlock>
        <SystemBlock
          heading="Grid"
          text="<code>Grid</code> sets its columns per breakpoint with the <code>xsmall</code>, <code>small</code>, <code>medium</code> and <code>large</code> props. <code>ruled</code> draws hairlines between the cells."
        >
          <SystemTable
            label="Breakpoints"
            head={["Prop", "Screen width", "Typical screen"]}
            rows={[
              ["<code>xsmall</code>", "Under 30rem, 480px", "Phones"],
              ["<code>small</code>", "30rem, 480px and up", "Large phones"],
              ["<code>medium</code>", "48rem, 768px and up", "Tablets"],
              [
                "<code>large</code>",
                "64rem, 1024px and up",
                "Laptops and desktops",
              ],
            ]}
          />
        </SystemBlock>
        <SystemBlock
          heading="Content wrapper"
          text="<code>ContentWrapper</code> lays out the content inside a section. Its variants cover most section layouts."
        >
          <SystemTable
            label="Content wrapper variants"
            head={["Variant", "Layout"]}
            rows={[
              [
                "<code>stack</code>",
                "One column. Add <code>centered</code> to center it.",
              ],
              [
                "<code>auto-width</code>",
                "Two groups on one row, each as wide as its content, wrapping when space runs out. Used for most section heads.",
              ],
              ["<code>columns</code>", "Two equal columns from 64rem."],
              [
                "<code>breakout</code>",
                "Text in the container, visual running to the screen edge.",
              ],
              [
                "<code>contain</code>",
                "Text and visual together on a surface panel.",
              ],
              [
                "<code>sticky-content</code>",
                "The text stays in view while the visual column scrolls.",
              ],
              [
                "<code>sticky-visual</code>",
                "The visual stays in view while the text scrolls.",
              ],
              ["<code>card</code>", "Centered content over a faded visual."],
            ]}
          />
        </SystemBlock>
      </SystemChapter>

      <SystemChapter
        id="shape"
        number="06"
        heading="Shape and depth"
        text="Three radii, one hairline and a single shadow. Depth comes from tone: a surface is one step lighter or darker than the section behind it."
      >
        <SystemBlock heading="Radius">
          <Grid small={3}>
            <SystemSample
              variant="corner-small"
              label="Small, 6px"
              note="Tags, form fields, icon tiles."
            />
            <SystemSample
              variant="corner-main"
              label="Main, 12px"
              note="Cards, media, panels."
            />
            <SystemSample
              variant="corner-round"
              label="Round"
              note="Buttons, tabs, the email field."
            />
          </Grid>
        </SystemBlock>
        <SystemBlock heading="Lines">
          <SystemTable
            label="Lines"
            head={["Line", "Token", "Use"]}
            rows={[
              [
                "Hairline",
                "<code>--border</code>, text color at 16%",
                "Dividers, ruled grids, accordion rows.",
              ],
              [
                "Control",
                "<code>--button-2-border</code>, text color at 40%",
                "Secondary buttons, link underlines.",
              ],
              [
                "Focus",
                "<code>--focus-width</code> 2px, 3px offset",
                "Buttons, links and tabs, for keyboard users only.",
              ],
            ]}
          />
        </SystemBlock>
        <SystemBlock
          heading="Elevation"
          text="Surfaces stay flat. The one shadow is for things that float above the page."
        >
          <Grid small={2}>
            <SystemSample
              variant="surface"
              label="Surface"
