---
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Card from "@/components/item/Card.astro";
import Form from "@/components/form/Form.astro";
import Input from "@/components/form/Input.astro";
import Button from "@/components/Button.astro";
import CtaDemo from "@/components/content/CtaDemo.astro";
import hero from "@/assets/images/solutions/hero.jpg";
import { getCollection } from "astro:content";

const solutions = (await getCollection("solutions")).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Compliance Solutions by Firm Type"
  description="Compliance solutions tailored for RIAs, broker-dealers, private funds, and hedge funds. 88% of customers eliminated multiple tools. See how Greenboard fits your firm type."
  overlap
>
  {/* Hero */}
  <HeroPage
    eyebrow="Solutions"
    heading="Intuitive compliance software that <strong>puts people first.</strong>"
    image={hero}
    maxWidth={20}
  >
    <Form name="demo-request" variant="inline">
      <Input
        variant="email"
        label="Work email"
        placeholder="Enter your work email address"
        labelHidden
        required
      />
      <Button type="submit">Get started</Button>
    </Form>
  </HeroPage>

  {/* Solutions by firm type */}
  <Section theme="soft" aria-labelledby="solutions-intro">
    <Heading tag="h2" class="heading-accent" maxWidth={40} id="solutions-intro">
      <strong>Greenboard</strong> is an AI-native, cloud-based operating system that
      streamlines compliance management, helping financial firms stay organized,
      efficient, and audit-ready—all in one place.
    </Heading>
    <Grid>
      {
        solutions.map((solution) => (
          <Card
            variant="split"
            heading={solution.data.name}
            text={solution.data.summary}
            image={solution.data.image}
            imageAlt={solution.data.imageAlt}
            buttonLabel="Learn more"
            buttonHref={`/solutions/${solution.id}`}
          />
        ))
      }
    </Grid>
  </Section>

  {/* Closing call to action */}
  <Section
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    id="demo"
    aria-labelledby="cta-title"
  >
    <CtaDemo />
  </Section>
</Layout>
