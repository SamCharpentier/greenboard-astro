---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Card from "@/components/item/Card.astro";
import VideoEmbed from "@/components/media/VideoEmbed.astro";
import CtaDemo from "@/components/content/CtaDemo.astro";
import podcastStill from "@/assets/images/blog/the-trust-podcast-episode-1-michael-kitces.jpg";

const stories = (
  await getCollection("caseStudies", ({ data }) => data.status === "published")
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const firmTypes = new Map(
  (await getCollection("solutions")).map((entry) => [entry.id, entry.data.name]),
);
---

<Layout title="Case Studies" description="Connecting the industry’s best, together.">
  {/* Hero */}
  <HeroPage
    theme="soft"
    eyebrow="Case Studies"
    heading="Practical case studies focused on simplifying financial operations with Greenboard."
    maxWidth={17}
  >
    <Grid slot="column2" class="gap-3">
      {
        stories.slice(0, 3).map((story) => (
          <Card
            variant="row"
            eyebrow={firmTypes.get(story.data.firmType.id)}
            heading={story.data.title}
            buttonLabel="Read the story"
            buttonHref={`/case-studies/${story.id}`}
          />
        ))
      }
    </Grid>
  </HeroPage>

  {/* Stories */}
  <Section theme="light" aria-labelledby="stories-title">
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={18} id="stories-title">
        Case studies across the ecosystem
      </Heading>
      <Paragraph slot="column2" maxWidth={48} class="color-faded">
        A complete view of how Greenboard partnerships come to life across
        industries, client types, and collaboration models, revealing the many
        ways the platform creates impact.
      </Paragraph>
    </ContentWrapper>
    <VideoEmbed
      src="https://player.vimeo.com/video/1011498413"
      title="The Trust Podcast Episode 1: Michael Kitces"
      poster={podcastStill}
    />
    <Grid medium={2} large={3} class="gap-row-8">
      {
        stories.map((story) => (
          <Card
            variant="stacked"
            image={story.data.logo}
            imageAlt={story.data.customer}
            imageFit="contain"
            eyebrow={firmTypes.get(story.data.firmType.id)}
            heading={story.data.title}
            text={story.data.excerpt}
            buttonLabel="Read the story"
            buttonHref={`/case-studies/${story.id}`}
          />
        ))
      }
    </Grid>
  </Section>

  {/* Closing call to action */}
  <Section
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    id="demo"
    aria-labelledby="cta-title"
  >
    <CtaDemo />
  </Section>
</Layout>
