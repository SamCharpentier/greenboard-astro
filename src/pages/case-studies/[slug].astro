---
import type { GetStaticPaths } from "astro";
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import Facts from "@/components/item/Facts.astro";
import Quote from "@/components/item/Quote.astro";
import Stat from "@/components/item/Stat.astro";
import Img from "@/components/media/Img.astro";
import TableOfContents from "@/components/interactive/TableOfContents.astro";
import Share from "@/components/interactive/Share.astro";
import CtaDemo from "@/components/content/CtaDemo.astro";

export const getStaticPaths = (async () => {
  const stories = (
    await getCollection("caseStudies", ({ data }) => data.status === "published")
  ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return stories.map((story) => ({
    params: { slug: story.id },
    props: { story, others: stories.filter((other) => other.id !== story.id) },
  }));
}) satisfies GetStaticPaths;

type Props = {
  story: CollectionEntry<"caseStudies">;
  others: CollectionEntry<"caseStudies">[];
};

const { story, others } = Astro.props;
const { data } = story;
const { Content, headings } = await render(story);
const firmType = await getEntry(data.firmType);
const firmTypes = new Map(
  (await getCollection("solutions")).map((entry) => [entry.id, entry.data.name]),
);
const person = await getEntry(data.quote.person);

/* Logos of any shape read at the same visual weight when they cover the same area */
const LOGO_AREA = 20000;
const logoHeight = Math.round(
  Math.sqrt(LOGO_AREA / (data.logo.width / data.logo.height)),
);
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  noindex={data.seo.noindex || undefined}
>
  {/* Hero */}
  <HeroPage
    backHref="/case-studies"
    backLabel="All case studies"
    eyebrow={firmType?.data.name}
    heading={data.title}
    maxWidth={30}
  >
    <Grid slot="footer" xsmall={2} large={4} class="gap-row-6">
      {
        data.stats.map((stat) => (
          <Stat size="medium" number={stat.number} unit={stat.unit} label={stat.label} />
        ))
      }
    </Grid>
  </HeroPage>

  {/* Overview */}
  <Section theme="soft" aria-label={`About ${data.customer}`}>
    <ContentWrapper variant="columns" column1Class="align-self-start">
      <Img
        src={data.logo}
        alt={data.customer}
        variant="densities"
        height={logoHeight}
        transparent
      />
      <Paragraph variant="large" maxWidth={44} class="margin-top-7">
        {data.summary}
      </Paragraph>
      <Facts slot="column2" variant="rows">
        {
          data.facts.map((fact) => (
            <div>
              <dt>
                <Eyebrow variant="tag" tag="span">
                  {fact.label}
                </Eyebrow>
              </dt>
              <dd>
                {fact.value.split("\n").map((line, index) => (
                  <>
                    {index > 0 && <br />}
                    {line}
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </Facts>
    </ContentWrapper>
  </Section>

  {/* Story */}
  <Section theme="light" aria-label={`The ${data.customer} story`}>
    <ContentWrapper variant="article">
      <TableOfContents headings={headings.filter((item) => item.depth === 2)} />
      <Quote
        slot="column2"
        variant="card"
        name={person.data.name}
        position={[person.data.role, person.data.company].filter(Boolean).join(", ")}
        image={person.data.image}
      >
        {data.quote.text}
      </Quote>
      <RichText slot="column2" article class="margin-top-8">
        <Content />
      </RichText>
      <Share slot="column2" class="margin-top-8" />
    </ContentWrapper>
  </Section>

  {/* More stories */}
  <Section theme="soft" render={others.length > 0} aria-labelledby="more-title">
    <ContentWrapper variant="auto-width">
      <Heading tag="h2" maxWidth={18} id="more-title">
        Case studies across the ecosystem
      </Heading>
      <Paragraph slot="column2" maxWidth={48} class="color-faded">
        A complete view of how Greenboard partnerships come to life across
        industries, client types, and collaboration models, revealing the many
        ways the platform creates impact.
      </Paragraph>
    </ContentWrapper>
    <Grid medium={2} large={3} class="gap-row-8">
      {
        others.map((other) => (
          <Card
            variant="stacked"
            image={other.data.logo}
            imageAlt={other.data.customer}
            imageFit="contain"
            eyebrow={firmTypes.get(other.data.firmType.id)}
            heading={other.data.title}
            text={other.data.excerpt}
            buttonLabel="Read the story"
            buttonHref={`/case-studies/${other.id}`}
          />
        ))
      }
    </Grid>
    <ButtonWrapper class="align-self-center">
      <Button element="link" href="/case-studies" emphasis="secondary" icon="back">
        All case studies
      </Button>
    </ButtonWrapper>
  </Section>

  {/* Closing call to action */}
  <Section
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    id="demo"
    aria-labelledby="cta-title"
  >
    <CtaDemo />
  </Section>
</Layout>
