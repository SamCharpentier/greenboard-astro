---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Card from "@/components/item/Card.astro";
import CtaDemo from "@/components/content/CtaDemo.astro";
import { formatDate } from "@/utils/date.ts";

const posts = (
  await getCollection("posts", ({ data }) => data.status === "published")
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = posts.filter((post) => post.data.featured);
const more = posts.filter((post) => !post.data.featured);
const authors = new Map(
  (await getCollection("people")).map((entry) => [entry.id, entry.data.name]),
);
---

<Layout
  title="Blog | Compliance Insights & Regulatory Updates"
  description="Insights on SEC and FINRA compliance, regulatory technology, and best practices for financial institutions from the Greenboard team."
>
  {/* Hero */}
  <HeroPage eyebrow="Blog" heading="Greenboard Guidance">
    <Paragraph variant="large">
      Insights on SEC and FINRA compliance, regulatory technology, and best
      practices for financial institutions from the Greenboard team.
    </Paragraph>
  </HeroPage>

  {/* Featured */}
  <Section
    theme="light"
    render={featured.length > 0}
    aria-labelledby="featured-title"
  >
    <Eyebrow tag="h2" id="featured-title">Featured</Eyebrow>
    <Grid medium={2}>
      {
        featured.map((post) => (
          <Card
            eyebrow={formatDate(post.data.date)}
            meta={post.data.author && authors.get(post.data.author.id)}
            heading={post.data.title}
            text={post.data.summary}
            buttonLabel="Read the article"
            buttonHref={`/blog/${post.id}`}
          />
        ))
      }
    </Grid>
  </Section>

  {/* Everything else */}
  <Section theme="soft" render={more.length > 0} aria-labelledby="more-title">
    <Eyebrow tag="h2" id="more-title">
      {featured.length > 0 ? "More articles" : "Articles"}
    </Eyebrow>
    <Grid medium={2} large={3} ruled>
      {
        more.map((post) => (
          <Card
            eyebrow={formatDate(post.data.date)}
            meta={post.data.author && authors.get(post.data.author.id)}
            heading={post.data.title}
            buttonHref={`/blog/${post.id}`}
          />
        ))
      }
    </Grid>
  </Section>

  {/* Closing call to action */}
  <Section
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    id="demo"
    aria-labelledby="cta-title"
  >
    <CtaDemo />
  </Section>
</Layout>
