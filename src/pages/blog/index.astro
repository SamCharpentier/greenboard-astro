---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Card from "@/components/item/Card.astro";
import CtaDemo from "@/components/content/CtaDemo.astro";
import defaultCover from "@/assets/images/blog/default-cover.jpg";
import { formatDate } from "@/utils/date.ts";

const posts = (
  await getCollection("posts", ({ data }) => data.status === "published")
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout
  title="Blog | Compliance Insights & Regulatory Updates"
  description="Insights on SEC and FINRA compliance, regulatory technology, and best practices for financial institutions from the Greenboard team."
>
  {/* Hero */}
  <HeroPage
    theme="light"
    eyebrow="Our blog"
    heading="Greenboard Guidance"
    paddingBottom="none"
  />

  {/* Articles */}
  <Section theme="light" paddingTop="none" aria-label="Articles">
    <Grid medium={2} large={3} class="gap-row-8">
      {
        posts.map((post) => (
          <Card
            variant="stacked"
            image={post.data.cover ?? defaultCover}
            imageAlt={post.data.coverAlt}
            meta={formatDate(post.data.date)}
            heading={post.data.title}
            buttonLabel="Read the article"
            buttonHref={`/blog/${post.id}`}
          />
        ))
      }
    </Grid>
  </Section>

  {/* Closing call to action */}
  <Section
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    id="demo"
    aria-labelledby="cta-title"
  >
    <CtaDemo />
  </Section>
</Layout>
