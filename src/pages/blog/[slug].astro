---
import type { GetStaticPaths } from "astro";
import {
  getCollection,
  getEntry,
  render,
  type CollectionEntry,
} from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Byline from "@/components/item/Byline.astro";
import Card from "@/components/item/Card.astro";
import Share from "@/components/interactive/Share.astro";
import TableOfContents from "@/components/interactive/TableOfContents.astro";
import CtaWhitepaper from "@/components/content/CtaWhitepaper.astro";
import CtaDemo from "@/components/content/CtaDemo.astro";
import defaultCover from "@/assets/images/blog/default-cover.jpg";
import { SITE_NAME, SITE_URL } from "@/consts.ts";
import { formatDate } from "@/utils/date.ts";

export const getStaticPaths = (async () => {
  const posts = (
    await getCollection("posts", ({ data }) => data.status === "published")
  ).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return posts.map((post) => ({
    params: { slug: post.id },
    props: {
      post,
      related: posts.filter((other) => other.id !== post.id).slice(0, 3),
    },
  }));
}) satisfies GetStaticPaths;

type Props = {
  post: CollectionEntry<"posts">;
  related: CollectionEntry<"posts">[];
};

const { post, related } = Astro.props;
const { data } = post;
const { Content, headings } = await render(post);
/* The contents list the post's top level of sections. Posts brought over from
   Webflow open their sections at h3 as often as h2, so the level is read from
   the post rather than fixed. */
const sectionDepth = Math.min(...headings.map((item) => item.depth).filter((depth) => depth > 1));
const sections = headings.filter((item) => item.depth === sectionDepth);
const author = data.author ? await getEntry(data.author) : undefined;
const byline = author && {
  name: author.data.name,
  position: author.data.company ? author.data.role : undefined,
  image: author.data.image,
  initials: author.data.company
    ? author.data.name
        .split(" ")
        .map((part) => part[0])
        .join("")
    : undefined,
};

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: data.title,
  description: data.seo.description,
  datePublished: data.date.toISOString(),
  author: author
    ? {
        "@type": author.data.company ? "Person" : "Organization",
        name: author.data.name,
      }
    : { "@type": "Organization", name: SITE_NAME },
  publisher: { "@type": "Organization", name: SITE_NAME, url: SITE_URL },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  type="article"
  noindex={data.seo.noindex || undefined}
>
  <script
    is:inline
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  {/* Hero */}
  <HeroPage
    backHref="/blog"
    backLabel="All articles"
    eyebrow={formatDate(data.date)}
    heading={data.title}
    maxWidth={30}
  >
    <ContentWrapper slot="footer" variant="auto-width" class="align-items-center">
      <Byline {...byline} />
      <Share slot="column2" />
    </ContentWrapper>
  </HeroPage>

  {/* Article */}
  <Section theme="light" aria-label="Article">
    <ContentWrapper variant="article">
      <TableOfContents headings={sections} />
      <RichText slot="column2" article>
        <Content />
      </RichText>
      <ContentWrapper
        slot="column2"
        variant="auto-width"
        class="align-items-center margin-top-8"
      >
        <Byline {...byline} />
        <Share slot="column2" />
      </ContentWrapper>
    </ContentWrapper>
  </Section>

  {/* Whitepaper */}
  <Section theme="dark" render={data.whitepaperForm} aria-labelledby="whitepaper-title">
    <CtaWhitepaper />
  </Section>

  {/* Related articles */}
  <Section theme="light" render={related.length > 0} aria-labelledby="related-title">
    <ContentWrapper variant="auto-width" class="align-items-center">
      <Heading tag="h2" variant="h1" maxWidth={20} id="related-title">
        Related articles
      </Heading>
      <Button slot="column2" element="link" href="/blog" emphasis="secondary" icon="back">
        All articles
      </Button>
    </ContentWrapper>
    <Grid medium={2} large={3} class="gap-row-8">
      {
        related.map((other) => (
          <Card
            variant="stacked"
            image={other.data.cover ?? defaultCover}
            imageAlt={other.data.coverAlt}
            meta={formatDate(other.data.date)}
            heading={other.data.title}
            buttonLabel="Read the article"
            buttonHref={`/blog/${other.id}`}
          />
        ))
      }
    </Grid>
  </Section>

  {/* Closing call to action */}
  <Section
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    id="demo"
    aria-labelledby="cta-title"
  >
    <CtaDemo />
  </Section>
</Layout>
