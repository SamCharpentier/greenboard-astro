---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import HeroPage from "@/components/section/HeroPage.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import RichText from "@/components/typography/RichText.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
import CtaDemo from "@/components/content/CtaDemo.astro";

export const getStaticPaths = (async () => {
  const partners = await getCollection(
    "partners",
    ({ data }) => data.status === "published",
  );
  return partners.map((partner) => ({
    params: { slug: partner.id },
    props: { partner },
  }));
}) satisfies GetStaticPaths;

type Props = { partner: CollectionEntry<"partners"> };

const { partner } = Astro.props;
const { data } = partner;
const { Content } = await render(partner);
const category = await getEntry(data.category);
---

<Layout
  title={data.seo.title}
  description={data.seo.description}
  noindex={data.seo.noindex || undefined}
>
  {/* Hero */}
  <HeroPage
    theme="soft"
    backHref="/partnerships#partners"
    backLabel="All partners"
    eyebrow={category?.data.name}
    heading={data.name}
    maxWidth={20}
  >
    <Paragraph variant="large">{data.summary}</Paragraph>
    <ButtonWrapper>
      <Button element="link" href="#demo">Learn more</Button>
      {
        data.website && (
          <Button
            element="link"
            href={data.website}
            emphasis="secondary"
            icon="diagonal"
            target="_blank"
            rel="noopener"
          >
            Website
          </Button>
        )
      }
    </ButtonWrapper>
    <Card
      slot="column2"
      variant="stacked"
      image={data.logo}
      imageAlt={data.name}
      imageFit="contain"
    />
  </HeroPage>

  {/* About the partner */}
  <Section theme="light" aria-label={`About ${data.name}`}>
    <ContentWrapper variant="article">
      <RichText article>
        <Content />
      </RichText>
    </ContentWrapper>
  </Section>

  {/* Closing call to action */}
  <Section
    theme="dark"
    paddingTop="large"
    paddingBottom="large"
    id="demo"
    aria-labelledby="cta-title"
  >
    <CtaDemo />
  </Section>
</Layout>
