---
import "@/styles/global.css";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import Banner from "@/components/global/Banner.astro";
import Nav from "@/components/global/Nav.astro";
import Footer from "@/components/global/Footer.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps & {
  /** Theme for the whole page. `inherit` leaves the root defaults in place. */
  theme?: "inherit" | "light" | "soft" | "dark" | "deep" | "brand";
  /**
   * Let the first section run up under the nav rather than starting below
   * it. Give that section `paddingTop="navoverlap"` to clear the bar.
   */
  overlap?: boolean;
};

const { theme = "inherit", overlap = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[theme !== "inherit" && `theme-${theme}`]}>
  <head>
    <BaseHead {...seo} />
    <slot name="head" />
  </head>
  <body>
    <SkipLink />
    <Banner
      text="Greenboard announces <strong>GreenboardGo and $20M in funding</strong>"
      href="/blog/greenboard-go-launch"
    />
    <Nav overlap={overlap} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
